import { Switch } from 'ark-ripple/switch';
import styles from 'styles/switch.module.css';

export component Context() {
  <Switch.Root class={styles.Root}>
    <Switch.Control class={styles.Control}>
      <Switch.Thumb class={styles.Thumb} />
    </Switch.Control>
    <Switch.Context>
      component children({ context }) {
        <Switch.Label class={styles.Label}>
          {'Feature is '}
          {@context.checked ? 'enabled' : 'disabled'}
        </Switch.Label>
      }
    </Switch.Context>
    <Switch.HiddenInput />
  </Switch.Root>
}
