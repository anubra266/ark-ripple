import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDialogContext } from './use-dialog-context';
import { usePresenceContext } from '../presence/use-presence-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DialogPositionerBaseProps extends PolymorphicProps<'div'> {}
export interface DialogPositionerProps extends HTMLProps<'div'>, DialogPositionerBaseProps {}

export component DialogPositioner(props: MaybeTracked<DialogPositionerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const dialog = useDialogContext();
  const presence = usePresenceContext();

  let mergedProps = track(() => mergeProps(@dialog.getPositionerProps(), @localProps));

  if (!@presence.unmounted) {
    <ark.div {...@mergedProps}>
      <@children />
    </ark.div>
  }
}
