import { Dialog } from 'ark-ripple/dialog';
import { Portal } from 'ark-ripple/portal';
import { track } from 'ripple';
import button from 'styles/button.module.css';
import styles from 'styles/dialog.module.css';

export component RapidStateChange() {
  let open = track(false);

  const handleClick = async () => {
    @open = true;
    await Promise.resolve();
    @open = false;
    await Promise.resolve();
    @open = true;
  };

  <div class="stack">
    <button class={button.Root} onClick={handleClick}>
      {'Open Dialog '}
      {String(@open)}
    </button>
    <Dialog.Root
      {@open}
      onOpenChange={(e) => {
        @open = e.open;
      }}
    >
      <Portal>
        <Dialog.Backdrop class={styles.Backdrop} />
        <Dialog.Positioner class={styles.Positioner}>
          <Dialog.Content class={styles.Content}>
            <Dialog.CloseTrigger class={styles.CloseTrigger}>{'✕'}</Dialog.CloseTrigger>
            <Dialog.Title class={styles.Title}>{'Rapid State Test'}</Dialog.Title>
            <Dialog.Description class={styles.Description}>
              {'This dialog tests rapid state changes (true → false → true). If working correctly, the dialog should be open after clicking the button.'}
            </Dialog.Description>
          </Dialog.Content>
        </Dialog.Positioner>
      </Portal>
    </Dialog.Root>
  </div>
}
