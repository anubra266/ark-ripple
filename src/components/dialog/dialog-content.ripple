import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDialogContext } from './use-dialog-context';
import { usePresenceContext } from '../presence/use-presence-context';
import { ark } from '../factory';

export interface DialogContentBaseProps {
  children?: any;
  [key: string]: any;
}
export type DialogContentProps = DialogContentBaseProps;

export component DialogContent(props: DialogContentProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const dialog = useDialogContext();
  const presence = usePresenceContext();

  let mergedProps = track(
    () => mergeProps(@dialog.getContentProps(), @presence.getPresenceProps(), @localProps),
  );

  if (!@presence.unmounted) {
    <ark.div
      {...@mergedProps}
      {ref (el: HTMLDivElement) => {
        @presence.setNode(el);
      }}
    >
      <@children />
    </ark.div>
  }
}
