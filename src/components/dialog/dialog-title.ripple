import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDialogContext } from './use-dialog-context';
import { ark } from '../factory';

export interface DialogTitleBaseProps {
  children?: any;
  [key: string]: any;
}
export type DialogTitleProps = DialogTitleBaseProps;

export component DialogTitle(props: DialogTitleProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const dialog = useDialogContext();

  let mergedProps = track(() => mergeProps(@dialog.getTitleProps(), @localProps));

  <ark.h2 {...@mergedProps}>
    <@children />
  </ark.h2>
}
