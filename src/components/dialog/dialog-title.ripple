import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDialogContext } from './use-dialog-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DialogTitleBaseProps extends PolymorphicProps<'h2'> {}
export interface DialogTitleProps extends HTMLProps<'h2'>, DialogTitleBaseProps {}

export component DialogTitle(props: MaybeTracked<DialogTitleProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const dialog = useDialogContext();

  let mergedProps = track(() => mergeProps(@dialog.getTitleProps(), @localProps));

  <ark.h2 {...@mergedProps}>
    <@children />
  </ark.h2>
}
