import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFieldContext } from '../field/use-field-context';
import { useFileUploadContext } from './use-file-upload-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FileUploadHiddenInputBaseProps extends PolymorphicProps<'input'> {}
export interface FileUploadHiddenInputProps extends HTMLProps<
  'input'
>, FileUploadHiddenInputBaseProps {}

export component FileUploadHiddenInput(props: MaybeTracked<FileUploadHiddenInputProps>) {
  const [localProps] = trackSplit(props, []);
  const fileUpload = useFileUploadContext();
  const field = useFieldContext();

  let mergedProps = track(
    () => mergeProps(
      @fileUpload.getHiddenInputProps(),
      { 'aria-describedby': @field?.ariaDescribedby },
      @localProps,
    ),
  );

  <ark.input {...@mergedProps} />
}
