import { FileUpload } from 'ark-ripple/file-upload';
import { File, Upload, X } from 'lucide-ripple';
import styles from 'styles/file-upload.module.css';

export component Dropzone() {
  <FileUpload.Root maxFiles={5} class={styles.Root}>
    <FileUpload.Label class={styles.Label}>{'File Upload'}</FileUpload.Label>
    <FileUpload.Dropzone class={styles.Dropzone}>
      <Upload class={styles.DropzoneIcon} />
      <div class={styles.DropzoneContent}>
        <span class={styles.DropzoneTitle}>{'Drag and drop files here'}</span>
        <span class={styles.DropzoneDescription}>{'or click to browse'}</span>
      </div>
    </FileUpload.Dropzone>
    <FileUpload.ItemGroup class={styles.ItemGroup}>
      <FileUpload.Context>
        component children({ context }) {
          for (const file of @context.acceptedFiles; key file.name) {
            <FileUpload.Item {file} class={styles.Item}>
              <FileUpload.ItemPreview type="image/*" class={styles.ItemPreview}>
                <FileUpload.ItemPreviewImage class={styles.ItemPreviewImage} />
              </FileUpload.ItemPreview>
              <FileUpload.ItemPreview type=".*" class={styles.ItemPreview}>
                <File />
              </FileUpload.ItemPreview>
              <FileUpload.ItemName class={styles.ItemName} />
              <FileUpload.ItemSizeText class={styles.ItemSizeText} />
              <FileUpload.ItemDeleteTrigger class={styles.ItemDeleteTrigger}>
                <X />
              </FileUpload.ItemDeleteTrigger>
            </FileUpload.Item>
          }
        }
      </FileUpload.Context>
    </FileUpload.ItemGroup>
    <FileUpload.HiddenInput />
  </FileUpload.Root>
}
