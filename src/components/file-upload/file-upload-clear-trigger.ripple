import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFileUploadContext } from './use-file-upload-context';
import { ark } from '../factory';

export interface FileUploadClearTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type FileUploadClearTriggerProps = FileUploadClearTriggerBaseProps;

export component FileUploadClearTrigger(props: FileUploadClearTriggerProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const fileUpload = useFileUploadContext();

  let mergedProps = track(() => mergeProps(@fileUpload.getClearTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
