import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFileUploadContext } from './use-file-upload-context';
import { useFileUploadItemPropsContext } from './use-file-upload-item-props-context';
import { ark } from '../factory';

export interface FileUploadItemDeleteTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type FileUploadItemDeleteTriggerProps = FileUploadItemDeleteTriggerBaseProps;

export component FileUploadItemDeleteTrigger(props: FileUploadItemDeleteTriggerProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const fileUpload = useFileUploadContext();
  const itemProps = useFileUploadItemPropsContext();

  let mergedProps = track(
    () => mergeProps(@fileUpload.getItemDeleteTriggerProps(@itemProps), @localProps),
  );

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
