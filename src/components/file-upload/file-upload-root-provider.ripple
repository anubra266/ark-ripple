import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { FileUploadApiContext } from './use-file-upload-context';
import type { UseFileUploadReturn } from './use-file-upload.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FileUploadRootProviderBaseProps extends PolymorphicProps<'div'> {
value: UseFileUploadReturn;
}
export interface FileUploadRootProviderProps extends HTMLProps<'div'>, FileUploadRootProviderBaseProps {}

export component FileUploadRootProvider(props: MaybeTracked<FileUploadRootProviderProps>) {
  const [children, value, localProps] = trackSplit(props, ['children', 'value']);

  FileUploadApiContext.set(value);

  let mergedProps = track(() => mergeProps(@value.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
