import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTimerContext } from './use-timer-context';
import { ark } from '../factory';

export interface TimerControlBaseProps {
	children?: any;
	[key: string]: any;
}
export type TimerControlProps = TimerControlBaseProps;

export component TimerControl(props: TimerControlProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const timer = useTimerContext();

	let mergedProps = track(() => mergeProps(@timer.getControlProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
