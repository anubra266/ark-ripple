import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { TimerApiContext } from './use-timer-context';
import type { UseTimerReturn } from './use-timer.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TimerRootProviderBaseProps extends PolymorphicProps<'div'> {
  value: UseTimerReturn;
}
export interface TimerRootProviderProps extends HTMLProps<'div'>, TimerRootProviderBaseProps {}

export component TimerRootProvider(props: MaybeTracked<TimerRootProviderProps>) {
  const [timer, children, localProps] = trackSplit(props, ['value', 'children']);

  TimerApiContext.set(timer);

  let mergedProps = track(() => mergeProps(@timer.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
