import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTimerContext } from './use-timer-context';
import { ark } from '../factory';

export interface TimerSeparatorBaseProps {
  children?: any;
  [key: string]: any;
}
export type TimerSeparatorProps = TimerSeparatorBaseProps;

export component TimerSeparator(props: TimerSeparatorProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const timer = useTimerContext();

  let mergedProps = track(() => mergeProps(@timer.getSeparatorProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
