import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { TimerApiContext } from './use-timer-context';
import { useTimer, type UseTimerProps } from './use-timer.ripple';
import { splitTimerProps } from './split-timer-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TimerRootBaseProps extends PolymorphicProps<'div'>, UseTimerProps {}
export interface TimerRootProps extends HTMLProps<'div'>, TimerRootBaseProps {}

export component TimerRoot(props: MaybeTracked<TimerRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [timerProps, localProps] = splitTimerProps(@rest);
  const timer = useTimer(timerProps);

  TimerApiContext.set(timer);

  let mergedProps = track(() => mergeProps(@timer.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
