import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { usePopoverContext } from './use-popover-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface PopoverDescriptionBaseProps extends PolymorphicProps<'div'> {}
export interface PopoverDescriptionProps extends HTMLProps<'div'>, PopoverDescriptionBaseProps {}

export component PopoverDescription(props: MaybeTracked<PopoverDescriptionProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const popover = usePopoverContext();

  let mergedProps = track(() => mergeProps(@popover.getDescriptionProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
