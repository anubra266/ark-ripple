import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { usePopoverContext } from './use-popover-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface PopoverCloseTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface PopoverCloseTriggerProps extends HTMLProps<
  'button'
>, PopoverCloseTriggerBaseProps {}

export component PopoverCloseTrigger(props: MaybeTracked<PopoverCloseTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const popover = usePopoverContext();

  let mergedProps = track(() => mergeProps(@popover.getCloseTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
