import * as popover from '@zag-js/popover';
import { useMachine, normalizeProps, type PropTypes } from 'zag-ripple';
import { track } from 'ripple';
import { useEnvironmentContext } from '../../providers/environment';
import { useLocaleContext } from '../../providers/locale';
import { useId } from '../../utils/use-id';
import type { Optional } from '../../types';

export interface UsePopoverProps extends Optional<
  Omit<popover.Props, 'dir' | 'getRootNode'>,
  'id'
> {}
export type UsePopoverReturn = ReturnType<typeof usePopover>;

export function usePopover(props: UsePopoverProps = {}) {
  const locale = useLocaleContext();
  const env = useEnvironmentContext();
  const id = useId();

  const machineProps = track(
    () => ({
      id,
      dir: @locale.dir,
      getRootNode: @env.getRootNode,
      ...@props,
    }),
  );

  const service = useMachine(popover.machine, machineProps);
  const api = track(() => popover.connect(service, normalizeProps));

  return api;
}
