import { Menu } from 'ark-ripple/menu';
import { Portal } from 'ark-ripple/portal';
import { TreeView, createTreeCollection, useTreeViewNodeContext } from 'ark-ripple/tree-view';
import { ChevronRight, File, Folder, FolderOpen } from 'lucide-ripple';
import menuStyles from 'styles/menu.module.css';
import styles from 'styles/tree-view.module.css';

interface Node {
  id: string;
  name: string;
  children?: Node[];
}

const collection = createTreeCollection<Node>(
  {
    nodeToValue: (node) => node.id,
    nodeToString: (node) => node.name,
    rootNode: {
      id: 'ROOT',
      name: '',
      children: [
        {
          id: 'node_modules',
          name: 'node_modules',
          children: [
            { id: 'node_modules/zag-js', name: 'zag-js' },
            { id: 'node_modules/pandacss', name: 'panda' },
            {
              id: 'node_modules/@types',
              name: '@types',
              children: [
                { id: 'node_modules/@types/react', name: 'react' },
                { id: 'node_modules/@types/react-dom', name: 'react-dom' },
              ],
            },
          ],
        },
        {
          id: 'src',
          name: 'src',
          children: [
            { id: 'src/app.tsx', name: 'app.tsx' },
            { id: 'src/index.ts', name: 'index.ts' },
          ],
        },
        { id: 'panda.config', name: 'panda.config.ts' },
        { id: 'package.json', name: 'package.json' },
        { id: 'renovate.json', name: 'renovate.json' },
        { id: 'readme.md', name: 'README.md' },
      ],
    },
  },
);

const getNodeId = (uid: string, value: string) => `${uid}/${value}`;

component TreeNodeContextMenu(props: { triggerId: string; children?: any }) {
  <Menu.Root ids={{ contextTrigger: props.triggerId }}>
    <@props.children />
    <Portal>
      <Menu.Positioner>
        <Menu.Content class={menuStyles.Content}>
          <Menu.Item class={menuStyles.Item} value="rename">{'Rename'}</Menu.Item>
          <Menu.Item class={menuStyles.Item} value="delete">{'Delete'}</Menu.Item>
        </Menu.Content>
      </Menu.Positioner>
    </Portal>
  </Menu.Root>
}

component TreeBranchIcon() {
  const nodeState = useTreeViewNodeContext();
  if (@nodeState.expanded) {
    <FolderOpen />
  } else {
    <Folder />
  }
}

component TreeNode(props: { node: Node; indexPath: number[]; triggerId: string }) {
  <TreeView.NodeProvider node={props.node} indexPath={props.indexPath}>
    if (props.node.children) {
      <TreeView.Branch class={styles.Branch}>
        <TreeNodeContextMenu triggerId={props.triggerId}>
          <TreeView.BranchControl class={styles.BranchControl}>
            component asChild({ propsFn }) {
              <Menu.ContextTrigger {...propsFn()}>
                <TreeView.BranchIndicator class={styles.BranchIndicator}>
                  <ChevronRight />
                </TreeView.BranchIndicator>
                <TreeView.BranchText class={styles.BranchText}>
                  <TreeBranchIcon />
                  {props.node.name}
                </TreeView.BranchText>
              </Menu.ContextTrigger>
            }
          </TreeView.BranchControl>
        </TreeNodeContextMenu>
        <TreeView.BranchContent class={styles.BranchContent}>
          <TreeView.BranchIndentGuide class={styles.BranchIndentGuide} />
          for (const child of props.node.children; index i; key child.id) {
            <TreeNode
              node={child}
              indexPath={[...props.indexPath, i]}
              triggerId={props.triggerId}
            />
          }
        </TreeView.BranchContent>
      </TreeView.Branch>
    } else {
      <TreeNodeContextMenu triggerId={props.triggerId}>
        <TreeView.Item class={styles.Item}>
          component asChild({ propsFn }) {
            <Menu.ContextTrigger {...propsFn()}>
              <File />
              <TreeView.ItemText class={styles.ItemText}>{props.node.name}</TreeView.ItemText>
            </Menu.ContextTrigger>
          }
        </TreeView.Item>
      </TreeNodeContextMenu>
    }
  </TreeView.NodeProvider>
}

export component ContextMenu() {
  const uid = 'tree-view';
  <TreeView.Root
    class={styles.Root}
    {collection}
    ids={{ node: (value: string) => getNodeId(uid, value) }}
  >
    <TreeView.Label class={styles.Label}>{'Tree'}</TreeView.Label>
    <TreeView.Tree class={styles.Tree}>
      for (const node of collection.rootNode.children!; index i; key node.id) {
        <TreeNode {node} indexPath={[i]} triggerId={getNodeId(uid, node.id)} />
      }
    </TreeView.Tree>
  </TreeView.Root>
}
