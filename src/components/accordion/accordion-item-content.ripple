import { mergeProps } from 'zag-ripple';
import { omit } from '@zag-js/utils';
import { trackSplit, track } from 'ripple';
import { CollapsibleContent } from '../collapsible/collapsible-content.ripple';
import { useAccordionContext } from './use-accordion-context';
import { useAccordionItemPropsContext } from './use-accordion-item-props-context';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface AccordionItemContentBaseProps extends PolymorphicProps<'div'> {}
export interface AccordionItemContentProps extends HTMLProps<'div'>, AccordionItemContentBaseProps {}

export component AccordionItemContent(props: MaybeTracked<AccordionItemContentProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const accordion = useAccordionContext();
  const itemProps = useAccordionItemPropsContext();

  const contentProps = track(
    () => omit(@accordion.getItemContentProps(@itemProps) as any, ['hidden', 'data-state']),
  );

  let mergedProps = track(() => mergeProps(@contentProps, @rest));

  <CollapsibleContent {...@mergedProps}>
    <@children />
  </CollapsibleContent>
}
