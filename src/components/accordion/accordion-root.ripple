import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import {
  splitRenderStrategyProps,
  RenderStrategyContext,
  type RenderStrategyProps,
} from '../../utils/render-strategy.ripple';
import { AccordionApiContext } from './use-accordion-context';
import { useAccordion, type UseAccordionProps } from './use-accordion.ripple';
import { splitAccordionProps } from './split-accordion-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface AccordionRootBaseProps extends PolymorphicProps<
  'div'
>, UseAccordionProps, RenderStrategyProps {}
export interface AccordionRootProps extends HTMLProps<'div'>, AccordionRootBaseProps {}

export component AccordionRoot(props: MaybeTracked<AccordionRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [renderStrategyProps, accordionProps] = splitRenderStrategyProps(@rest);
  const [useAccordionProps, localProps] = splitAccordionProps(@accordionProps);
  const accordion = useAccordion(useAccordionProps);

  AccordionApiContext.set(accordion);
  RenderStrategyContext.set(renderStrategyProps);

  let mergedProps = track(() => mergeProps(@accordion.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
