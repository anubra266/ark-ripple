import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useAccordionContext } from './use-accordion-context';
import { useAccordionItemPropsContext } from './use-accordion-item-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface AccordionItemIndicatorBaseProps extends PolymorphicProps<'div'> {}
export interface AccordionItemIndicatorProps extends HTMLProps<
  'div'
>, AccordionItemIndicatorBaseProps {}

export component AccordionItemIndicator(props: MaybeTracked<AccordionItemIndicatorProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const accordion = useAccordionContext();
  const itemProps = useAccordionItemPropsContext();

  let mergedProps = track(() => mergeProps(@accordion.getItemIndicatorProps(@itemProps), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
