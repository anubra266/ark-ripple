import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { SegmentGroupApiContext } from './use-segment-group-context';
import { useSegmentGroup, type UseSegmentGroupProps } from './use-segment-group.ripple';
import { splitSegmentGroupProps } from './split-segment-group-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SegmentGroupRootBaseProps extends PolymorphicProps<'div'>, UseSegmentGroupProps {}
export interface SegmentGroupRootProps extends HTMLProps<'div'>, SegmentGroupRootBaseProps {}

export component SegmentGroupRoot(props: MaybeTracked<SegmentGroupRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [segmentGroupProps, localProps] = splitSegmentGroupProps(@rest);
  const segmentGroup = useSegmentGroup(segmentGroupProps);

  SegmentGroupApiContext.set(segmentGroup);

  let mergedProps = track(() => mergeProps(@segmentGroup.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
