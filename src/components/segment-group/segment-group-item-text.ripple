import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSegmentGroupContext } from './use-segment-group-context';
import { useSegmentGroupItemPropsContext } from './use-segment-group-item-props-context';
import { ark } from '../factory';

export interface SegmentGroupItemTextBaseProps {
  children?: any;
  [key: string]: any;
}
export type SegmentGroupItemTextProps = SegmentGroupItemTextBaseProps;

export component SegmentGroupItemText(props: SegmentGroupItemTextProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const segmentGroup = useSegmentGroupContext();
  const itemProps = useSegmentGroupItemPropsContext();

  let mergedProps = track(
    () => mergeProps(@segmentGroup.getItemTextProps(@itemProps), @localProps),
  );

  <ark.span {...@mergedProps}>
    <@children />
  </ark.span>
}
