import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSegmentGroupContext } from './use-segment-group-context';
import { useSegmentGroupItemPropsContext } from './use-segment-group-item-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SegmentGroupItemTextBaseProps extends PolymorphicProps<'span'> {}
export interface SegmentGroupItemTextProps extends HTMLProps<'span'>, SegmentGroupItemTextBaseProps {}

export component SegmentGroupItemText(props: MaybeTracked<SegmentGroupItemTextProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const segmentGroup = useSegmentGroupContext();
  const itemProps = useSegmentGroupItemPropsContext();

  let mergedProps = track(
    () => mergeProps(@segmentGroup.getItemTextProps(@itemProps), @localProps),
  );

  <ark.span {...@mergedProps}>
    <@children />
  </ark.span>
}
