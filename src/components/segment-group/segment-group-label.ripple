import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSegmentGroupContext } from './use-segment-group-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SegmentGroupLabelBaseProps extends PolymorphicProps<'label'> {}
export interface SegmentGroupLabelProps extends HTMLProps<'label'>, SegmentGroupLabelBaseProps {}

export component SegmentGroupLabel(props: MaybeTracked<SegmentGroupLabelProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const segmentGroup = useSegmentGroupContext();

  let mergedProps = track(() => mergeProps(@segmentGroup.getLabelProps(), @localProps));

  <ark.label {...@mergedProps}>
    <@children />
  </ark.label>
}
