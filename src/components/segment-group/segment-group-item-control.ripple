import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSegmentGroupContext } from './use-segment-group-context';
import { useSegmentGroupItemPropsContext } from './use-segment-group-item-props-context';
import { ark } from '../factory';

export interface SegmentGroupItemControlBaseProps {
  children?: any;
  [key: string]: any;
}
export type SegmentGroupItemControlProps = SegmentGroupItemControlBaseProps;

export component SegmentGroupItemControl(props: SegmentGroupItemControlProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const segmentGroup = useSegmentGroupContext();
  const itemProps = useSegmentGroupItemPropsContext();

  let mergedProps = track(
    () => mergeProps(@segmentGroup.getItemControlProps(@itemProps), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
