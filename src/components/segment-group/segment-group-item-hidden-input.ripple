import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSegmentGroupContext } from './use-segment-group-context';
import { useSegmentGroupItemPropsContext } from './use-segment-group-item-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SegmentGroupItemHiddenInputBaseProps extends PolymorphicProps<'input'> {}
export interface SegmentGroupItemHiddenInputProps extends HTMLProps<
  'input'
>, SegmentGroupItemHiddenInputBaseProps {}

export component SegmentGroupItemHiddenInput(props: MaybeTracked<SegmentGroupItemHiddenInputProps>) {
  const [localProps] = trackSplit(props, []);
  const segmentGroup = useSegmentGroupContext();
  const itemProps = useSegmentGroupItemPropsContext();

  let mergedProps = track(
    () => mergeProps(@segmentGroup.getItemHiddenInputProps(@itemProps), @localProps),
  );

  <ark.input {...@mergedProps} />
}
