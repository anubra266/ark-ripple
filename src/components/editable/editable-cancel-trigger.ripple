import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useEditableContext } from './use-editable-context';
import { ark } from '../factory';

export interface EditableCancelTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type EditableCancelTriggerProps = EditableCancelTriggerBaseProps;

export component EditableCancelTrigger(props: EditableCancelTriggerProps) {
  const [children, rest] = trackSplit(props, ['children']);
  const editable = useEditableContext();

  let mergedProps = track(() => mergeProps(@editable.getCancelTriggerProps(), @rest));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
