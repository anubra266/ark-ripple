import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { EditableApiContext } from './use-editable-context';
import { useEditable, type UseEditableProps } from './use-editable.ripple';
import { splitEditableProps } from './split-editable-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface EditableRootBaseProps extends PolymorphicProps<'div'>, UseEditableProps {}
export interface EditableRootProps extends HTMLProps<'div'>, EditableRootBaseProps {}

export component EditableRoot(props: MaybeTracked<EditableRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [editableProps, localProps] = splitEditableProps(@rest);
  const editable = useEditable(editableProps);

  EditableApiContext.set(editable);

  let mergedProps = track(() => mergeProps(@editable.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
