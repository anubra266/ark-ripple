import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { EditableApiContext } from './use-editable-context';
import type { UseEditableReturn } from './use-editable.ripple';
import { ark } from '../factory';

export interface EditableRootProviderBaseProps {
	value: UseEditableReturn;
	children?: any;
	[key: string]: any;
}
export type EditableRootProviderProps = EditableRootProviderBaseProps;

export component EditableRootProvider(props: EditableRootProviderProps) {
	const [children, value, localProps] = trackSplit(props, ['children', 'value']);

	EditableApiContext.set(value);

	let mergedProps = track(() => mergeProps(@value.getRootProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
