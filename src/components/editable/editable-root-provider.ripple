import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { EditableApiContext } from './use-editable-context';
import type { UseEditableReturn } from './use-editable.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface EditableRootProviderBaseProps extends PolymorphicProps<'div'> {
value: UseEditableReturn;
}
export interface EditableRootProviderProps extends HTMLProps<'div'>, EditableRootProviderBaseProps {}

export component EditableRootProvider(props: MaybeTracked<EditableRootProviderProps>) {
  const [children, value, localProps] = trackSplit(props, ['children', 'value']);

  EditableApiContext.set(value);

  let mergedProps = track(() => mergeProps(@value.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
