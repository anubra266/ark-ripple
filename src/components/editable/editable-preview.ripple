import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useEditableContext } from './use-editable-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface EditablePreviewBaseProps extends PolymorphicProps<'span'> {}
export interface EditablePreviewProps extends HTMLProps<'span'>, EditablePreviewBaseProps {}

export component EditablePreview(props: MaybeTracked<EditablePreviewProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const editable = useEditableContext();

  let mergedProps = track(() => mergeProps(@editable.getPreviewProps(), @rest));

  <ark.span {...@mergedProps}>
    if (@children) {
      <@children />
    } else {
      {@editable.valueText}
    }
  </ark.span>
}
