import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useEditableContext } from './use-editable-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface EditableEditTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface EditableEditTriggerProps extends HTMLProps<
  'button'
>, EditableEditTriggerBaseProps {}

export component EditableEditTrigger(props: MaybeTracked<EditableEditTriggerProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const editable = useEditableContext();

  let mergedProps = track(() => mergeProps(@editable.getEditTriggerProps(), @rest));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
