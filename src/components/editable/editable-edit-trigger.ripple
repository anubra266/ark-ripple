import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useEditableContext } from './use-editable-context';
import { ark } from '../factory';

export interface EditableEditTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type EditableEditTriggerProps = EditableEditTriggerBaseProps;

export component EditableEditTrigger(props: EditableEditTriggerProps) {
  const [children, rest] = trackSplit(props, ['children']);
  const editable = useEditableContext();

  let mergedProps = track(() => mergeProps(@editable.getEditTriggerProps(), @rest));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
