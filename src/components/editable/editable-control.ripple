import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useEditableContext } from './use-editable-context';
import { ark } from '../factory';

export interface EditableControlBaseProps {
  children?: any;
  [key: string]: any;
}
export type EditableControlProps = EditableControlBaseProps;

export component EditableControl(props: EditableControlProps) {
  const [children, rest] = trackSplit(props, ['children']);
  const editable = useEditableContext();

  let mergedProps = track(() => mergeProps(@editable.getControlProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
