import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useEditableContext } from './use-editable-context';
import { ark } from '../factory';

export interface EditableLabelBaseProps {
	children?: any;
	[key: string]: any;
}
export type EditableLabelProps = EditableLabelBaseProps;

export component EditableLabel(props: EditableLabelProps) {
	const [children, rest] = trackSplit(props, ['children']);
	const editable = useEditableContext();

	let mergedProps = track(() => mergeProps(@editable.getLabelProps(), @rest));

	<ark.label {...@mergedProps}>
		<@children />
	</ark.label>
}
