import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useEditableContext } from './use-editable-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface EditableAreaBaseProps extends PolymorphicProps<'div'> {}
export interface EditableAreaProps extends HTMLProps<'div'>, EditableAreaBaseProps {}

export component EditableArea(props: MaybeTracked<EditableAreaProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const editable = useEditableContext();

  let mergedProps = track(() => mergeProps(@editable.getAreaProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
