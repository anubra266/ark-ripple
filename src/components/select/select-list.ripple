import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSelectContext } from './use-select-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SelectListBaseProps extends PolymorphicProps<'div'> {}
export interface SelectListProps extends HTMLProps<'div'>, SelectListBaseProps {}

export component SelectList(props: MaybeTracked<SelectListProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const select = useSelectContext();

  let mergedProps = track(() => mergeProps(@select.getListProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
