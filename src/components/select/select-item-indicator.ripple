import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSelectContext } from './use-select-context';
import { useSelectItemPropsContext } from './use-select-item-props-context';
import { ark } from '../factory';

export interface SelectItemIndicatorBaseProps {
  children?: any;
  [key: string]: any;
}
export type SelectItemIndicatorProps = SelectItemIndicatorBaseProps;

export component SelectItemIndicator(props: SelectItemIndicatorProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const select = useSelectContext();
  const itemProps = useSelectItemPropsContext();

  let mergedProps = track(() => mergeProps(@select.getItemIndicatorProps(@itemProps), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
