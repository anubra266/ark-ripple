import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSelectContext } from './use-select-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SelectIndicatorBaseProps extends PolymorphicProps<'div'> {}
export interface SelectIndicatorProps extends HTMLProps<'div'>, SelectIndicatorBaseProps {}

export component SelectIndicator(props: MaybeTracked<SelectIndicatorProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const select = useSelectContext();

  let mergedProps = track(() => mergeProps(@select.getIndicatorProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
