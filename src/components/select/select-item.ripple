import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import type { ItemProps } from '@zag-js/select';
import { useSelectContext } from './use-select-context';
import { SelectItemApiContext } from './use-select-item-context';
import { SelectItemPropsContext } from './use-select-item-props-context';
import { ark } from '../factory';

export interface SelectItemBaseProps extends ItemProps {
  children?: any;
  [key: string]: any;
}
export type SelectItemProps = SelectItemBaseProps;

export component SelectItem(props: SelectItemProps) {
  const [item, disabled, children, rest] = trackSplit(props, ['item', 'disabled', 'children']);
  const select = useSelectContext();

  const itemProps = track(() => ({ item: @item, disabled: @disabled }));
  let mergedProps = track(() => mergeProps(@select.getItemProps(@itemProps), @rest));

  SelectItemApiContext.set(track(() => @select.getItemState(@itemProps)));
  SelectItemPropsContext.set(itemProps);

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
