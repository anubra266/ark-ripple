import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTagsInputContext } from './use-tags-input-context';
import { useTagsInputItemPropsContext } from './use-tags-input-item-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TagsInputItemPreviewBaseProps extends PolymorphicProps<'div'> {}
export interface TagsInputItemPreviewProps extends HTMLProps<
  'div'
>, TagsInputItemPreviewBaseProps {}

export component TagsInputItemPreview(props: MaybeTracked<TagsInputItemPreviewProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const api = useTagsInputContext();
  const itemProps = useTagsInputItemPropsContext();

  let mergedProps = track(() => mergeProps(@api.getItemPreviewProps(@itemProps), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
