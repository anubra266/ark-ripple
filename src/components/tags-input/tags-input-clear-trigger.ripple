import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTagsInputContext } from './use-tags-input-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TagsInputClearTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface TagsInputClearTriggerProps extends HTMLProps<
  'button'
>, TagsInputClearTriggerBaseProps {}

export component TagsInputClearTrigger(props: MaybeTracked<TagsInputClearTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const api = useTagsInputContext();

  let mergedProps = track(() => mergeProps(@api.getClearTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
