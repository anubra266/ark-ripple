import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTagsInputContext } from './use-tags-input-context';
import { useTagsInputItemPropsContext } from './use-tags-input-item-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TagsInputItemTextBaseProps extends PolymorphicProps<'span'> {}
export interface TagsInputItemTextProps extends HTMLProps<'span'>, TagsInputItemTextBaseProps {}

export component TagsInputItemText(props: MaybeTracked<TagsInputItemTextProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const api = useTagsInputContext();
  const itemProps = useTagsInputItemPropsContext();

  let mergedProps = track(() => mergeProps(@api.getItemTextProps(@itemProps), @localProps));

  <ark.span {...@mergedProps}>
    <@children />
  </ark.span>
}
