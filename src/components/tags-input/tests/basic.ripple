import { TagsInput } from 'ark-ripple/tags-input';
import { Field } from 'ark-ripple/field';

export component ComponentUnderTest(props: TagsInput.RootProps) {
  <TagsInput.Root defaultValue={['react', 'solid', 'vue']} {...props}>
    <TagsInput.Context>
      component children({ context }) {
        <TagsInput.Label>{'Frameworks'}</TagsInput.Label>
        <TagsInput.Control>
          for (const value of @context.value; index i; key value) {
            <TagsInput.Item index={i} {value}>
              <TagsInput.ItemPreview>
                <TagsInput.ItemText>{value}</TagsInput.ItemText>
                <TagsInput.ItemDeleteTrigger>{'Delete'}</TagsInput.ItemDeleteTrigger>
              </TagsInput.ItemPreview>
              <TagsInput.ItemInput />
            </TagsInput.Item>
          }
        </TagsInput.Control>
        <TagsInput.Input placeholder="Add tag" />
        <TagsInput.ClearTrigger>{'Clear all'}</TagsInput.ClearTrigger>
      }
    </TagsInput.Context>
    <TagsInput.HiddenInput />
  </TagsInput.Root>
}

export component TagsInputWithField(props: Field.RootProps) {
  <Field.Root {...props}>
    <TagsInput.Root>
      <TagsInput.Context>
        component children({ context }) {
          <TagsInput.Label>{'Label'}</TagsInput.Label>
          <TagsInput.Control>
            for (const value of @context.value; index i; key value) {
              <TagsInput.Item index={i} {value}>
                <TagsInput.ItemPreview>
                  <TagsInput.ItemText>{value}</TagsInput.ItemText>
                  <TagsInput.ItemDeleteTrigger>{'Delete'}</TagsInput.ItemDeleteTrigger>
                </TagsInput.ItemPreview>
                <TagsInput.ItemInput />
              </TagsInput.Item>
            }
          </TagsInput.Control>
          <TagsInput.Input placeholder="Add tag" />
        }
      </TagsInput.Context>
      <TagsInput.HiddenInput />
    </TagsInput.Root>
    <Field.HelperText>{'Additional Info'}</Field.HelperText>
    <Field.ErrorText>{'Error Info'}</Field.ErrorText>
  </Field.Root>
}
