import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { ToggleGroupApiContext } from './use-toggle-group-context';
import { useToggleGroup, type UseToggleGroupProps } from './use-toggle-group.ripple';
import { splitToggleGroupProps } from './split-toggle-group-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ToggleGroupRootBaseProps extends PolymorphicProps<'div'>, UseToggleGroupProps {}
export interface ToggleGroupRootProps extends HTMLProps<'div'>, ToggleGroupRootBaseProps {}

export component ToggleGroupRoot(props: MaybeTracked<ToggleGroupRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [toggleGroupProps, localProps] = splitToggleGroupProps(@rest);
  const toggleGroup = useToggleGroup(toggleGroupProps);

  ToggleGroupApiContext.set(toggleGroup);

  let mergedProps = track(() => mergeProps(@toggleGroup.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
