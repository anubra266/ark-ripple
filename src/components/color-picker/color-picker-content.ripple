import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { usePresenceContext } from '../presence';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerContentBaseProps extends PolymorphicProps<'div'> {}
export interface ColorPickerContentProps extends HTMLProps<'div'>, ColorPickerContentBaseProps {}

export component ColorPickerContent(props: MaybeTracked<ColorPickerContentProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const colorPicker = useColorPickerContext();
  const presence = usePresenceContext();

  let mergedProps = track(
    () => mergeProps(@colorPicker.getContentProps(), @presence.getPresenceProps(), @localProps),
  );

  if (!@presence.unmounted) {
    <ark.div
      {...@mergedProps}
      {ref (el: HTMLDivElement) => {
        @presence.setNode(el);
      }}
    >
      <@children />
    </ark.div>
  }
}
