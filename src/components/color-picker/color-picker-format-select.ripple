import { mergeProps } from 'zag-ripple';
import { track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerFormatSelectBaseProps extends PolymorphicProps<'select'> {}
export interface ColorPickerFormatSelectProps extends HTMLProps<'select'>, ColorPickerFormatSelectBaseProps {}

export component ColorPickerFormatSelect(props: MaybeTracked<ColorPickerFormatSelectProps>) {
  const colorPicker = useColorPickerContext();

  let mergedProps = track(() => mergeProps(@colorPicker.getFormatSelectProps(), @props));

  <ark.select {...@mergedProps}>
    for (const format of ['rgba', 'hsla', 'hsba']; key format) {
      <option value={format}>{format}</option>
    }
  </ark.select>
}
