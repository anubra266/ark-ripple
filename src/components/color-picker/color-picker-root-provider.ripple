import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { ColorPickerApiContext, type UseColorPickerContext } from './use-color-picker-context';
import { PresenceApiContext } from '../presence/use-presence-context';
import { splitPresenceProps } from '../presence/split-presence-props.ripple';
import { usePresence, type UsePresenceProps } from '../presence/use-presence.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerRootProviderBaseProps extends PolymorphicProps<
  'div'
>, UsePresenceProps {
  value: UseColorPickerContext;
}
export interface ColorPickerRootProviderProps extends HTMLProps<
  'div'
>, ColorPickerRootProviderBaseProps {}

export component ColorPickerRootProvider(props: MaybeTracked<ColorPickerRootProviderProps>) {
  const [children, value, rest] = trackSplit(props, ['children', 'value']);
  const [presenceProps, localProps] = splitPresenceProps(@rest);

  const present = track(() => @value.open);
  const presence = usePresence({ present, ...@presenceProps });

  ColorPickerApiContext.set(value);
  PresenceApiContext.set(presence);

  let mergedProps = track(() => mergeProps(@value.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
