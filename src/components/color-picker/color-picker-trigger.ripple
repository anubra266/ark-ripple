import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';

export interface ColorPickerTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type ColorPickerTriggerProps = ColorPickerTriggerBaseProps;

export component ColorPickerTrigger(props: ColorPickerTriggerProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const colorPicker = useColorPickerContext();

  let mergedProps = track(() => mergeProps(@colorPicker.getTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
