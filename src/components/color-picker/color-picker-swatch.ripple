import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import type { SwatchProps } from '@zag-js/color-picker';
import { ColorPickerSwatchPropsContext } from './use-color-picker-swatch-props-context';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerSwatchBaseProps extends PolymorphicProps<'div'>, SwatchProps {}
export interface ColorPickerSwatchProps extends HTMLProps<'div'>, ColorPickerSwatchBaseProps {}

export component ColorPickerSwatch(props: MaybeTracked<ColorPickerSwatchProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [respectAlpha, value, localProps] = trackSplit(@rest, ['respectAlpha', 'value']);
  const colorPicker = useColorPickerContext();

  const swatchProps = track(() => ({ respectAlpha: @respectAlpha, value: @value }));
  ColorPickerSwatchPropsContext.set(swatchProps);

  let mergedProps = track(() => mergeProps(@colorPicker.getSwatchProps(@swatchProps), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
