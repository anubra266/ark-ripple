import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerSwatchTriggerBaseProps extends PolymorphicProps<'button'> {
value: any;
  disabled?: boolean | undefined;
}
export interface ColorPickerSwatchTriggerProps extends HTMLProps<'button'>, ColorPickerSwatchTriggerBaseProps {}

export component ColorPickerSwatchTrigger(props: MaybeTracked<ColorPickerSwatchTriggerProps>) {
  const [children, value, disabled, localProps] = trackSplit(props, [
    'children',
    'value',
    'disabled',
  ]);
  const colorPicker = useColorPickerContext();

  let mergedProps = track(
    () => mergeProps(
      @colorPicker.getSwatchTriggerProps({ value: @value, disabled: @disabled }),
      @localProps,
    ),
  );

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
