import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { usePresenceContext } from '../presence';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerPositionerBaseProps extends PolymorphicProps<'div'> {}
export interface ColorPickerPositionerProps extends HTMLProps<
  'div'
>, ColorPickerPositionerBaseProps {}

export component ColorPickerPositioner(props: MaybeTracked<ColorPickerPositionerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const colorPicker = useColorPickerContext();
  const presence = usePresenceContext();

  let mergedProps = track(() => mergeProps(@colorPicker.getPositionerProps(), @localProps));

  if (!@presence.unmounted) {
    <ark.div {...@mergedProps}>
      <@children />
    </ark.div>
  }
}
