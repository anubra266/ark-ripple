import { mergeProps } from 'zag-ripple';
import { track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { useColorPickerAreaPropsContext } from './use-color-picker-area-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerAreaThumbBaseProps extends PolymorphicProps<'div'> {}
export interface ColorPickerAreaThumbProps extends HTMLProps<
  'div'
>, ColorPickerAreaThumbBaseProps {}

export component ColorPickerAreaThumb(props: MaybeTracked<ColorPickerAreaThumbProps>) {
  const colorPicker = useColorPickerContext();
  const areaProps = useColorPickerAreaPropsContext();

  let mergedProps = track(() => mergeProps(@colorPicker.getAreaThumbProps(@areaProps), @props));

  <ark.div {...@mergedProps} />
}
