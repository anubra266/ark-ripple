import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';

export interface ColorPickerFormatTriggerBaseProps {
	children?: any;
	[key: string]: any;
}
export type ColorPickerFormatTriggerProps = ColorPickerFormatTriggerBaseProps;

export component ColorPickerFormatTrigger(props: ColorPickerFormatTriggerProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const colorPicker = useColorPickerContext();

	let mergedProps = track(() => mergeProps(@colorPicker.getFormatTriggerProps(), @localProps));

	<ark.button {...@mergedProps}>
		<@children />
	</ark.button>
}
