import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerTransparencyGridBaseProps extends PolymorphicProps<'div'> {
  size?: string | undefined;
}
export interface ColorPickerTransparencyGridProps extends HTMLProps<
  'div'
>, ColorPickerTransparencyGridBaseProps {}

export component ColorPickerTransparencyGrid(props: MaybeTracked<ColorPickerTransparencyGridProps>) {
  const [size, localProps] = trackSplit(props, ['size']);
  const colorPicker = useColorPickerContext();

  let mergedProps = track(
    () => mergeProps(@colorPicker.getTransparencyGridProps({ size: @size }), @localProps),
  );

  <ark.div {...@mergedProps} />
}
