import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';

export interface ColorPickerTransparencyGridBaseProps {
  size?: string | undefined;
  [key: string]: any;
}
export type ColorPickerTransparencyGridProps = ColorPickerTransparencyGridBaseProps;

export component ColorPickerTransparencyGrid(props: ColorPickerTransparencyGridProps) {
  const [size, localProps] = trackSplit(props, ['size']);
  const colorPicker = useColorPickerContext();

  let mergedProps = track(
    () => mergeProps(@colorPicker.getTransparencyGridProps({ size: @size }), @localProps),
  );

  <ark.div {...@mergedProps} />
}
