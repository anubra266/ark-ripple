import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import type { ChannelProps } from '@zag-js/color-picker';
import { ColorPickerChannelPropsContext } from './use-color-picker-channel-props-context';
import { useColorPickerContext } from './use-color-picker-context';
import { useColorPickerFormatContext } from './use-color-picker-format-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerChannelSliderBaseProps extends PolymorphicProps<'div'>, ChannelProps {}
export interface ColorPickerChannelSliderProps extends HTMLProps<'div'>, ColorPickerChannelSliderBaseProps {}

export component ColorPickerChannelSlider(props: MaybeTracked<ColorPickerChannelSliderProps>) {
  const [children, channel, orientation, localProps] = trackSplit(props, [
    'children',
    'channel',
    'orientation',
  ]);

  const colorPicker = useColorPickerContext();
  const formatProps = useColorPickerFormatContext();

  const channelProps = track(() => ({ channel: @channel, orientation: @orientation }));
  ColorPickerChannelPropsContext.set(channelProps);

  const channelSliderProps = track(() => ({ ...@channelProps, ...@formatProps }));
  let mergedProps = track(
    () => mergeProps(@colorPicker.getChannelSliderProps(@channelSliderProps), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
