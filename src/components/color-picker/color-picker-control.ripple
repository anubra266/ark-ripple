import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerControlBaseProps extends PolymorphicProps<'div'> {}
export interface ColorPickerControlProps extends HTMLProps<'div'>, ColorPickerControlBaseProps {}

export component ColorPickerControl(props: MaybeTracked<ColorPickerControlProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const colorPicker = useColorPickerContext();

  let mergedProps = track(() => mergeProps(@colorPicker.getControlProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
