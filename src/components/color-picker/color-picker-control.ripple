import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';

export interface ColorPickerControlBaseProps {
	children?: any;
	[key: string]: any;
}
export type ColorPickerControlProps = ColorPickerControlBaseProps;

export component ColorPickerControl(props: ColorPickerControlProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const colorPicker = useColorPickerContext();

	let mergedProps = track(() => mergeProps(@colorPicker.getControlProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
