import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { useColorPickerSwatchPropsContext } from './use-color-picker-swatch-props-context';
import { ark } from '../factory';

export interface ColorPickerSwatchIndicatorBaseProps {
	children?: any;
	[key: string]: any;
}
export type ColorPickerSwatchIndicatorProps = ColorPickerSwatchIndicatorBaseProps;

export component ColorPickerSwatchIndicator(props: ColorPickerSwatchIndicatorProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const colorPicker = useColorPickerContext();
	const swatchProps = useColorPickerSwatchPropsContext();

	let mergedProps = track(
		() => mergeProps(@colorPicker.getSwatchIndicatorProps(@swatchProps), @localProps),
	);

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
