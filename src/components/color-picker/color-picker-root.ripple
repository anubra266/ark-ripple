import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { ColorPickerApiContext } from './use-color-picker-context';
import { useColorPicker, type UseColorPickerProps } from './use-color-picker.ripple';
import { splitColorPickerProps } from './split-color-picker-props.ripple';
import { PresenceApiContext } from '../presence/use-presence-context';
import { splitPresenceProps } from '../presence/split-presence-props.ripple';
import { usePresence, type UsePresenceProps } from '../presence/use-presence.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerRootBaseProps extends PolymorphicProps<'div'>, UseColorPickerProps, UsePresenceProps {}
export interface ColorPickerRootProps extends HTMLProps<'div'>, ColorPickerRootBaseProps {}

export component ColorPickerRoot(props: MaybeTracked<ColorPickerRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [presenceProps, colorPickerRest] = splitPresenceProps(@rest);
  const [colorPickerProps, localProps] = splitColorPickerProps(@colorPickerRest);

  const colorPicker = useColorPicker(colorPickerProps);
  const present = track(() => @colorPicker.open);
  const presence = usePresence({ present, ...@presenceProps });

  ColorPickerApiContext.set(colorPicker);
  PresenceApiContext.set(presence);

  let mergedProps = track(() => mergeProps(@colorPicker.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
