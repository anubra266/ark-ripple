import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { ColorPickerSwatchPropsContext } from './use-color-picker-swatch-props-context';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerValueSwatchBaseProps extends PolymorphicProps<'div'> {
respectAlpha?: boolean | undefined;
}
export interface ColorPickerValueSwatchProps extends HTMLProps<'div'>, ColorPickerValueSwatchBaseProps {}

export component ColorPickerValueSwatch(props: MaybeTracked<ColorPickerValueSwatchProps>) {
  const [children, respectAlpha, localProps] = trackSplit(props, ['children', 'respectAlpha']);
  const colorPicker = useColorPickerContext();

  const swatchProps = track(
    () => ({
      respectAlpha: @respectAlpha,
      value: @colorPicker.valueAsString,
    }),
  );
  ColorPickerSwatchPropsContext.set(swatchProps);

  let mergedProps = track(() => mergeProps(@colorPicker.getSwatchProps(@swatchProps), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
