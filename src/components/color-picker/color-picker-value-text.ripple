import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useColorPickerContext } from './use-color-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ColorPickerValueTextBaseProps extends PolymorphicProps<'span'> {
format?: string | undefined;
}
export interface ColorPickerValueTextProps extends HTMLProps<'span'>, ColorPickerValueTextBaseProps {}

export component ColorPickerValueText(props: MaybeTracked<ColorPickerValueTextProps>) {
  const [children, format, localProps] = trackSplit(props, ['children', 'format']);
  const colorPicker = useColorPickerContext();

  let mergedProps = track(() => mergeProps(@colorPicker.getValueTextProps(), @localProps));
  let valueAsString = track(
    () => @format ? @colorPicker.value.toString(@format) : @colorPicker.valueAsString,
  );

  <ark.span {...@mergedProps}>
    if (@children) {
      <@children />
    } else {
      {@valueAsString}
    }
  </ark.span>
}
