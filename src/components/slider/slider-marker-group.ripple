import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSliderContext } from './use-slider-context';
import { ark } from '../factory';

export interface SliderMarkerGroupBaseProps {
  children?: any;
  [key: string]: any;
}
export type SliderMarkerGroupProps = SliderMarkerGroupBaseProps;

export component SliderMarkerGroup(props: SliderMarkerGroupProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const slider = useSliderContext();

  let mergedProps = track(() => mergeProps(@slider.getMarkerGroupProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
