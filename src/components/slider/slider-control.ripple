import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSliderContext } from './use-slider-context';
import { ark } from '../factory';

export interface SliderControlBaseProps {
	children?: any;
	[key: string]: any;
}
export type SliderControlProps = SliderControlBaseProps;

export component SliderControl(props: SliderControlProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const slider = useSliderContext();

	let mergedProps = track(() => mergeProps(@slider.getControlProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
