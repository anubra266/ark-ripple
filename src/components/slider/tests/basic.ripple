import { Slider, type SliderRootProps } from 'ark-ripple/slider';
import { track } from 'ripple';

export component ComponentUnderTest(props: SliderRootProps) {
	let value = track([-20, 20]);

	<Slider.Root
		min={-50}
		max={50}
		{@value}
		onValueChange={(e) => {
			@value = e.value;
		}}
		{...props}
	>
		<Slider.Label>{'Quantity: '}</Slider.Label>
		<Slider.ValueText />
		<Slider.Control>
			<Slider.Track>
				<Slider.Range />
			</Slider.Track>
			for (const _ of @value; index index; key index) {
				<Slider.Thumb {index}>
					<Slider.DraggingIndicator />
					<Slider.HiddenInput />
				</Slider.Thumb>
			}
		</Slider.Control>
		<Slider.MarkerGroup>
			<Slider.Marker value={-30}>{'*'}</Slider.Marker>
			<Slider.Marker value={0}>{'*'}</Slider.Marker>
			<Slider.Marker value={30}>{'*'}</Slider.Marker>
		</Slider.MarkerGroup>
	</Slider.Root>
}
