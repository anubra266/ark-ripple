import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSliderContext } from './use-slider-context';
import { ark } from '../factory';

export interface SliderLabelBaseProps {
  children?: any;
  [key: string]: any;
}
export type SliderLabelProps = SliderLabelBaseProps;

export component SliderLabel(props: SliderLabelProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const slider = useSliderContext();

  let mergedProps = track(() => mergeProps(@slider.getLabelProps(), @localProps));

  <ark.label {...@mergedProps}>
    <@children />
  </ark.label>
}
