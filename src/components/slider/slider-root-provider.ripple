import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { SliderApiContext } from './use-slider-context';
import type { UseSliderReturn } from './use-slider.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SliderRootProviderBaseProps extends PolymorphicProps<'div'> {
value: UseSliderReturn;
}
export interface SliderRootProviderProps extends HTMLProps<'div'>, SliderRootProviderBaseProps {}

export component SliderRootProvider(props: MaybeTracked<SliderRootProviderProps>) {
  const [children, value, localProps] = trackSplit(props, ['children', 'value']);

  let mergedProps = track(() => mergeProps(@value.getRootProps(), @localProps));

  SliderApiContext.set(value);

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
