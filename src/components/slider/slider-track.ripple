import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSliderContext } from './use-slider-context';
import { ark } from '../factory';

export interface SliderTrackBaseProps {
	children?: any;
	[key: string]: any;
}
export type SliderTrackProps = SliderTrackBaseProps;

export component SliderTrack(props: SliderTrackProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const slider = useSliderContext();

	let mergedProps = track(() => mergeProps(@slider.getTrackProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
