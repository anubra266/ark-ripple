import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { SliderApiContext } from './use-slider-context';
import { useSlider, type UseSliderProps } from './use-slider.ripple';
import { splitSliderProps } from './split-slider-props.ripple';
import { ark } from '../factory';

export interface SliderRootBaseProps extends UseSliderProps {
  children?: any;
  [key: string]: any;
}
export type SliderRootProps = SliderRootBaseProps;

export component SliderRoot(props: SliderRootProps) {
  const [children, rest] = trackSplit(props, ['children']);
  const [sliderProps, localProps] = splitSliderProps(@rest);

  const slider = useSlider(sliderProps);
  let mergedProps = track(() => mergeProps(@slider.getRootProps(), @localProps));

  SliderApiContext.set(slider);

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
