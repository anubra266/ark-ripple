import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { SliderApiContext } from './use-slider-context';
import { useSlider, type UseSliderProps } from './use-slider.ripple';
import { splitSliderProps } from './split-slider-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SliderRootBaseProps extends PolymorphicProps<'div'>, UseSliderProps {}
export interface SliderRootProps extends HTMLProps<'div'>, SliderRootBaseProps {}

export component SliderRoot(props: MaybeTracked<SliderRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [sliderProps, localProps] = splitSliderProps(@rest);

  const slider = useSlider(sliderProps);
  let mergedProps = track(() => mergeProps(@slider.getRootProps(), @localProps));

  SliderApiContext.set(slider);

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
