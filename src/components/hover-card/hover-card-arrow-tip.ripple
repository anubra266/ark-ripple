import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useHoverCardContext } from './use-hover-card-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface HoverCardArrowTipBaseProps extends PolymorphicProps<'div'> {}
export interface HoverCardArrowTipProps extends HTMLProps<'div'>, HoverCardArrowTipBaseProps {}

export component HoverCardArrowTip(props: MaybeTracked<HoverCardArrowTipProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const hoverCard = useHoverCardContext();

  let mergedProps = track(() => mergeProps(@hoverCard.getArrowTipProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
