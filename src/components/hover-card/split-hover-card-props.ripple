import { createSplitProps } from '../../utils/create-split-props.ripple';
import type { UseHoverCardProps } from './use-hover-card.ripple';

const splitProps = createSplitProps<UseHoverCardProps>();

export function splitHoverCardProps<T extends UseHoverCardProps & Record<string, any>>(props: T) {
  return splitProps(props, [
    'closeDelay',
    'defaultOpen',
    'dir',
    'disabled',
    'id',
    'ids',
    'onFocusOutside',
    'onInteractOutside',
    'onOpenChange',
    'onPointerDownOutside',
    'open',
    'openDelay',
    'positioning',
  ]);
}
