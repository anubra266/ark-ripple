import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useHoverCardContext } from './use-hover-card-context';
import { usePresenceContext } from '../presence/use-presence-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface HoverCardPositionerBaseProps extends PolymorphicProps<'div'> {}
export interface HoverCardPositionerProps
  extends HTMLProps<'div'>,
    HoverCardPositionerBaseProps {}

export component HoverCardPositioner(props: MaybeTracked<HoverCardPositionerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const hoverCard = useHoverCardContext();
  const presence = usePresenceContext();

  let mergedProps = track(() => mergeProps(@hoverCard.getPositionerProps(), @localProps));

  if (!@presence.unmounted) {
    <ark.div {...@mergedProps}>
      <@children />
    </ark.div>
  }
}
