import * as hoverCard from '@zag-js/hover-card';
import { useMachine, normalizeProps, type PropTypes } from 'zag-ripple';
import { track } from 'ripple';
import { useEnvironmentContext } from '../../providers/environment';
import { useLocaleContext } from '../../providers/locale';
import { useId } from '../../utils/use-id';
import type { Optional } from '../../types';

export interface UseHoverCardProps
  extends Optional<Omit<hoverCard.Props, 'getRootNode'>, 'id'> {}
export type UseHoverCardReturn = ReturnType<typeof useHoverCard>;

export function useHoverCard(props: UseHoverCardProps = {}) {
  const locale = useLocaleContext();
  const env = useEnvironmentContext();
  const id = useId();

  const machineProps = track(
    () => ({
      id,
      dir: @locale.dir,
      getRootNode: @env.getRootNode,
      ...@props,
    }),
  );

  const service = useMachine(hoverCard.machine, machineProps);
  const api = track(() => hoverCard.connect(service, normalizeProps));

  return api;
}
