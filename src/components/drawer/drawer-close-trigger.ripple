import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDrawerContext } from './use-drawer-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DrawerCloseTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface DrawerCloseTriggerProps extends HTMLProps<'button'>, DrawerCloseTriggerBaseProps {}

export component DrawerCloseTrigger(props: MaybeTracked<DrawerCloseTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const drawer = useDrawerContext();

  let mergedProps = track(() => mergeProps(@drawer.getCloseTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
