import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDrawerContext } from './use-drawer-context';
import { usePresenceContext } from '../presence/use-presence-context';
import { ark } from '../factory';

export interface DrawerTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type DrawerTriggerProps = DrawerTriggerBaseProps;

export component DrawerTrigger(props: DrawerTriggerProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const drawer = useDrawerContext();
  const presence = usePresenceContext();

  let triggerBaseProps = track(() => @drawer.getTriggerProps());
  let mergedProps = track(
    () => mergeProps(
      {
        ...@triggerBaseProps,
        'aria-controls': @presence.unmounted ? undefined : @triggerBaseProps['aria-controls'],
      },
      @localProps,
    ),
  );

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
