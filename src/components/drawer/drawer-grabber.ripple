import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDrawerContext } from './use-drawer-context';
import { ark } from '../factory';

export interface DrawerGrabberBaseProps {
	children?: any;
	[key: string]: any;
}
export type DrawerGrabberProps = DrawerGrabberBaseProps;

export component DrawerGrabber(props: DrawerGrabberProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const drawer = useDrawerContext();

	let mergedProps = track(() => mergeProps(@drawer.getGrabberProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
