import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDrawerStackContext } from './use-drawer-stack-context';
import { ark } from '../factory';

export interface DrawerIndentBaseProps {
	children?: any;
	[key: string]: any;
}
export type DrawerIndentProps = DrawerIndentBaseProps;

export component DrawerIndent(props: DrawerIndentProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const stackApi = useDrawerStackContext();

	let mergedProps = track(() => mergeProps(@stackApi!.getIndentProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
