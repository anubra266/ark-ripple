import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFloatingPanelContext } from './use-floating-panel-context';
import { usePresenceContext } from '../presence/use-presence-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FloatingPanelTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface FloatingPanelTriggerProps extends HTMLProps<
  'button'
>, FloatingPanelTriggerBaseProps {}

export component FloatingPanelTrigger(props: MaybeTracked<FloatingPanelTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const floatingPanel = useFloatingPanelContext();
  const presence = usePresenceContext();

  let triggerBaseProps = track(() => @floatingPanel.getTriggerProps());
  let mergedProps = track(
    () => mergeProps(
      {
        ...@triggerBaseProps,
        'aria-controls': @presence.unmounted ? undefined : @triggerBaseProps['aria-controls'],
      },
      @localProps,
    ),
  );

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
