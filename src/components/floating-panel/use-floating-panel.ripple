import * as floatingPanel from '@zag-js/floating-panel';
import { useMachine, normalizeProps, type PropTypes } from 'zag-ripple';
import { track } from 'ripple';
import { useEnvironmentContext } from '../../providers/environment';
import { useLocaleContext } from '../../providers/locale';
import { useId } from '../../utils/use-id';
import type { Optional } from '../../types';

export interface UseFloatingPanelProps
  extends Optional<Omit<floatingPanel.Props, 'getRootNode'>, 'id'> {}
export type UseFloatingPanelReturn = ReturnType<typeof useFloatingPanel>;

export function useFloatingPanel(props: UseFloatingPanelProps = {}) {
  const locale = useLocaleContext();
  const env = useEnvironmentContext();
  const id = useId();

  const machineProps = track(
    () => ({
      id,
      dir: @locale.dir,
      getRootNode: @env.getRootNode,
      ...@props,
    }),
  );

  const service = useMachine(floatingPanel.machine, machineProps);
  const api = track(() => floatingPanel.connect(service, normalizeProps));

  return api;
}
