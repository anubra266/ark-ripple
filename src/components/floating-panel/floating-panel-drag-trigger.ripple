import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFloatingPanelContext } from './use-floating-panel-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FloatingPanelDragTriggerBaseProps extends PolymorphicProps<'div'> {}
export interface FloatingPanelDragTriggerProps extends HTMLProps<
  'div'
>, FloatingPanelDragTriggerBaseProps {}

export component FloatingPanelDragTrigger(props: MaybeTracked<FloatingPanelDragTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const floatingPanel = useFloatingPanelContext();

  let mergedProps = track(() => mergeProps(@floatingPanel.getDragTriggerProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
