import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFloatingPanelContext } from './use-floating-panel-context';
import { usePresenceContext } from '../presence/use-presence-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FloatingPanelContentBaseProps extends PolymorphicProps<'div'> {}
export interface FloatingPanelContentProps
  extends HTMLProps<'div'>,
    FloatingPanelContentBaseProps {}

export component FloatingPanelContent(props: MaybeTracked<FloatingPanelContentProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const floatingPanel = useFloatingPanelContext();
  const presence = usePresenceContext();

  let mergedProps = track(
    () =>
      mergeProps(
        @floatingPanel.getContentProps(),
        @presence.getPresenceProps(),
        @localProps,
      ),
  );

  if (!@presence.unmounted) {
    <ark.div
      {...@mergedProps}
      {ref (el: HTMLDivElement) => {
        @presence.setNode(el);
      }}
    >
      <@children />
    </ark.div>
  }
}
