import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useToastContext } from './use-toast-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ToastActionTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface ToastActionTriggerProps extends HTMLProps<'button'>, ToastActionTriggerBaseProps {}

export component ToastActionTrigger(props: MaybeTracked<ToastActionTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const toast = useToastContext();

  let mergedProps = track(() => mergeProps(@toast.getActionTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
