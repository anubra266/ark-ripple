import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useToastContext } from './use-toast-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ToastCloseTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface ToastCloseTriggerProps extends HTMLProps<'button'>, ToastCloseTriggerBaseProps {}

export component ToastCloseTrigger(props: MaybeTracked<ToastCloseTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const toast = useToastContext();

  let mergedProps = track(() => mergeProps(@toast.getCloseTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
