import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { datePickerAnatomy } from './date-picker.anatomy';
import { useDatePickerContext } from './use-date-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DatePickerValueTextBaseProps extends PolymorphicProps<'span'> {
  placeholder?: string | undefined;
  separator?: string | undefined;
}
export interface DatePickerValueTextProps extends HTMLProps<'span'>, DatePickerValueTextBaseProps {}

export component DatePickerValueText(props: MaybeTracked<DatePickerValueTextProps>) {
  const [placeholder, separator, localProps] = trackSplit(props, ['placeholder', 'separator']);
  const datePicker = useDatePickerContext();

  let mergedProps = track(() => mergeProps(datePickerAnatomy.build().valueText.attrs, @localProps));

  const displayText = track(() => {
    const sep = @separator ?? ', ';
    return @datePicker.value.length > 0 ? @datePicker.valueAsString.join(sep) : @placeholder ?? '';
  });

  <ark.span {...@mergedProps}>{@displayText}</ark.span>
}
