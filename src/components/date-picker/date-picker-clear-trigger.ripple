import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDatePickerContext } from './use-date-picker-context';
import { ark } from '../factory';

export interface DatePickerClearTriggerBaseProps {
	children?: any;
	[key: string]: any;
}
export type DatePickerClearTriggerProps = DatePickerClearTriggerBaseProps;

export component DatePickerClearTrigger(props: DatePickerClearTriggerProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const datePicker = useDatePickerContext();

	let mergedProps = track(() => mergeProps(@datePicker.getClearTriggerProps(), @localProps));

	<ark.button {...@mergedProps}>
		<@children />
	</ark.button>
}
