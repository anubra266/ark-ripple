import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import type { DateValue, WeekNumberCellProps } from '@zag-js/date-picker';
import { useDatePickerContext } from './use-date-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DatePickerWeekNumberCellBaseProps extends PolymorphicProps<'td'>, WeekNumberCellProps {}
export interface DatePickerWeekNumberCellProps extends HTMLProps<'td'>, DatePickerWeekNumberCellBaseProps {}

export component DatePickerWeekNumberCell(props: MaybeTracked<DatePickerWeekNumberCellProps>) {
  const [children, weekIndex, week, localProps] = trackSplit(props, [
    'children',
    'weekIndex',
    'week',
  ]);
  const datePicker = useDatePickerContext();

  const cellProps = track(() => ({ weekIndex: @weekIndex, week: @week as DateValue[] }));
  let mergedProps = track(
    () => mergeProps(@datePicker.getWeekNumberCellProps(@cellProps), @localProps),
  );

  <ark.td {...@mergedProps}>
    <@children />
  </ark.td>
}
