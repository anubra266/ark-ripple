import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { DatePickerApiContext } from './use-date-picker-context';
import { PresenceApiContext } from '../presence/use-presence-context';
import { splitPresenceProps } from '../presence/split-presence-props.ripple';
import { usePresence, type UsePresenceProps } from '../presence/use-presence.ripple';
import type { UseDatePickerReturn } from './use-date-picker.ripple';
import { ark } from '../factory';

export interface DatePickerRootProviderBaseProps extends UsePresenceProps {
  value: UseDatePickerReturn;
  children?: any;
  [key: string]: any;
}
export type DatePickerRootProviderProps = DatePickerRootProviderBaseProps;

export component DatePickerRootProvider(props: DatePickerRootProviderProps) {
  const [children, rest] = trackSplit(props, ['children']);
  const [presenceProps, localProps] = splitPresenceProps(@rest);

  const datePicker = props.value;
  const present = track(() => @datePicker.open);

  const presence = usePresence({ present, ...@presenceProps });
  let mergedProps = track(() => mergeProps(@datePicker.getRootProps(), @localProps));

  DatePickerApiContext.set(datePicker);
  PresenceApiContext.set(presence);

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
