import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { uniq } from '@zag-js/utils';
import { useDatePickerContext } from './use-date-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DatePickerRangeTextBaseProps extends PolymorphicProps<'div'> {}
export interface DatePickerRangeTextProps extends HTMLProps<'div'>, DatePickerRangeTextBaseProps {}

export component DatePickerRangeText(props: MaybeTracked<DatePickerRangeTextProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const datePicker = useDatePickerContext();

  let mergedProps = track(() => mergeProps(@datePicker.getRangeTextProps(), @localProps));

  const visibleRangeText = track(() => {
    const { start, end } = @datePicker.visibleRangeText;
    return uniq([start, end]).filter(Boolean).join(' - ');
  });

  <ark.div {...@mergedProps}>
    if (@children) {
      <@children />
    } else {
      {@visibleRangeText}
    }
  </ark.div>
}
