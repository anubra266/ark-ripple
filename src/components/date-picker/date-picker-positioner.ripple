import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDatePickerContext } from './use-date-picker-context';
import { usePresenceContext } from '../presence';
import { ark } from '../factory';

export interface DatePickerPositionerBaseProps {
	children?: any;
	[key: string]: any;
}
export type DatePickerPositionerProps = DatePickerPositionerBaseProps;

export component DatePickerPositioner(props: DatePickerPositionerProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const datePicker = useDatePickerContext();
	const presence = usePresenceContext();

	let mergedProps = track(() => mergeProps(@datePicker.getPositionerProps(), @localProps));

	if (!@presence.unmounted) {
		<ark.div {...@mergedProps}>
			<@children />
		</ark.div>
	}
}
