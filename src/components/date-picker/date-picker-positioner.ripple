import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDatePickerContext } from './use-date-picker-context';
import { usePresenceContext } from '../presence';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DatePickerPositionerBaseProps extends PolymorphicProps<'div'> {}
export interface DatePickerPositionerProps extends HTMLProps<
  'div'
>, DatePickerPositionerBaseProps {}

export component DatePickerPositioner(props: MaybeTracked<DatePickerPositionerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const datePicker = useDatePickerContext();
  const presence = usePresenceContext();

  let mergedProps = track(() => mergeProps(@datePicker.getPositionerProps(), @localProps));

  if (!@presence.unmounted) {
    <ark.div {...@mergedProps}>
      <@children />
    </ark.div>
  }
}
