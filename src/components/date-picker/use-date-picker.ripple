import * as datePicker from '@zag-js/date-picker';
import { useMachine, normalizeProps, type PropTypes } from 'zag-ripple';
import { track, type Tracked } from 'ripple';
import { useEnvironmentContext } from '../../providers/environment';
import { useLocaleContext } from '../../providers/locale';
import { useId } from '../../utils/use-id';
import type { Optional } from '../../types';

export interface UseDatePickerProps extends Optional<
  Omit<datePicker.Props, 'dir' | 'getRootNode'>,
  'id'
> {}

export interface UseDatePickerReturn extends datePicker.Api<PropTypes> {}

export function useDatePicker(props: Tracked<UseDatePickerProps> = {}): UseDatePickerReturn {
  const locale = useLocaleContext();
  const env = useEnvironmentContext();
  const id = useId();

  const machineProps = track(
    () => ({
      id,
      dir: @locale.dir,
      locale: @locale.locale,
      getRootNode: @env.getRootNode,
      ...@props,
    }),
  );

  const service = useMachine(datePicker.machine, machineProps);
  const api = track(() => datePicker.connect(service, normalizeProps));

  return api;
}
