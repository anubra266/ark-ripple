import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { DatePickerApiContext } from './use-date-picker-context';
import { PresenceApiContext } from '../presence/use-presence-context';
import { splitPresenceProps } from '../presence/split-presence-props.ripple';
import { usePresence } from '../presence/use-presence.ripple';
import { useDatePicker, type UseDatePickerProps } from './use-date-picker.ripple';
import { splitDatePickerProps } from './split-date-picker-props.ripple';
import type { UsePresenceProps } from '../presence/use-presence.ripple';
import { ark } from '../factory';

export interface DatePickerRootBaseProps extends UseDatePickerProps, UsePresenceProps {
  children?: any;
  [key: string]: any;
}
export type DatePickerRootProps = DatePickerRootBaseProps;

export component DatePickerRoot(props: DatePickerRootProps) {
  const [children, rest] = trackSplit(props, ['children']);
  const [presenceProps, datePickerProps] = splitPresenceProps(@rest);
  const [useDatePickerProps, localProps] = splitDatePickerProps(@datePickerProps);

  const datePicker = useDatePicker(useDatePickerProps);
  const present = track(() => @datePicker.open);

  let presence = usePresence({ present, ...@presenceProps });
  let mergedProps = track(() => mergeProps(@datePicker.getRootProps(), @localProps));

  DatePickerApiContext.set(datePicker);
  PresenceApiContext.set(presence);

  <ark.div {...@mergedProps}>
    <props.children />
  </ark.div>
}
