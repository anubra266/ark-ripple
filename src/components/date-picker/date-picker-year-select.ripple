import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDatePickerContext } from './use-date-picker-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DatePickerYearSelectBaseProps extends PolymorphicProps<'select'> {}
export interface DatePickerYearSelectProps extends HTMLProps<'select'>, DatePickerYearSelectBaseProps {}

export component DatePickerYearSelect(props: MaybeTracked<DatePickerYearSelectProps>) {
  const [localProps] = trackSplit(props, []);
  const datePicker = useDatePickerContext();

  let mergedProps = track(() => mergeProps(@datePicker.getYearSelectProps(), @localProps));

  <ark.select {...@mergedProps}>
    for (const year of @datePicker.getYears()) {
      <option value={year.value}>{year.label}</option>
    }
  </ark.select>
}
