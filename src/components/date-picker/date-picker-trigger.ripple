import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDatePickerContext } from './use-date-picker-context';
import { ark } from '../factory';

export interface DatePickerTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type DatePickerTriggerProps = DatePickerTriggerBaseProps;

export component DatePickerTrigger(props: DatePickerTriggerProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const datePicker = useDatePickerContext();

  let mergedProps = track(() => mergeProps(@datePicker.getTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
