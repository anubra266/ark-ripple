import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDatePickerContext } from './use-date-picker-context';
import { useDatePickerTablePropsContext } from './use-date-picker-table-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DatePickerTableHeaderBaseProps extends PolymorphicProps<'th'> {}
export interface DatePickerTableHeaderProps extends HTMLProps<'th'>, DatePickerTableHeaderBaseProps {}

export component DatePickerTableHeader(props: MaybeTracked<DatePickerTableHeaderProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const datePicker = useDatePickerContext();
  const tableProps = useDatePickerTablePropsContext();

  let mergedProps = track(
    () => mergeProps(@datePicker.getTableHeaderProps(@tableProps), @localProps),
  );

  <ark.th {...@mergedProps}>
    <@children />
  </ark.th>
}
