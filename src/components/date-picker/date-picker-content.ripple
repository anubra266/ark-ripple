import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useDatePickerContext } from './use-date-picker-context';
import { usePresenceContext } from '../presence';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface DatePickerContentBaseProps extends PolymorphicProps<'div'> {}
export interface DatePickerContentProps extends HTMLProps<'div'>, DatePickerContentBaseProps {}

export component DatePickerContent(props: MaybeTracked<DatePickerContentProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const datePicker = useDatePickerContext();
  const presence = usePresenceContext();

  let mergedProps = track(
    () => mergeProps(@datePicker.getContentProps(), @presence.getPresenceProps(), @localProps),
  );

  if (!@presence.unmounted) {
    <ark.div
      {...@mergedProps}
      {ref (el: HTMLDivElement) => {
        @presence.setNode(el);
      }}
    >
      <@children />
    </ark.div>
  }
}
