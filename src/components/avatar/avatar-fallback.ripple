import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useAvatarContext } from './use-avatar-context';
import { ark } from '../factory';

export interface AvatarFallbackBaseProps {
	children?: any;
	[key: string]: any;
}
export type AvatarFallbackProps = AvatarFallbackBaseProps;

export component AvatarFallback(props: AvatarFallbackProps) {
	const [children, rest] = trackSplit(props, ['children']);
	const avatarApi = useAvatarContext();

	let mergedProps = track(() => mergeProps(@avatarApi.getFallbackProps(), @rest));

	<ark.span {...@mergedProps}>
		<@children />
	</ark.span>
}
