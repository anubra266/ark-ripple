import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useAvatarContext } from './use-avatar-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface AvatarImageBaseProps extends PolymorphicProps<'img'> {}
export interface AvatarImageProps extends HTMLProps<'img'>, AvatarImageBaseProps {}

export component AvatarImage(props: MaybeTracked<AvatarImageProps>) {
  const [localProps] = trackSplit(props, []);
  const avatarApi = useAvatarContext();

  let mergedProps = track(() => mergeProps(@avatarApi.getImageProps(), @localProps));

  <ark.img {...@mergedProps} />
}
