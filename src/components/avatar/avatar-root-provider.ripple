import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { AvatarApiContext } from './use-avatar-context';
import type { UseAvatarReturn } from './use-avatar.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface AvatarRootProviderBaseProps extends PolymorphicProps<'div'> {
value: UseAvatarReturn;
}
export interface AvatarRootProviderProps extends HTMLProps<'div'>, AvatarRootProviderBaseProps {}

export component AvatarRootProvider(props: MaybeTracked<AvatarRootProviderProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const avatarApi = props.value;

  AvatarApiContext.set(avatarApi);

  let mergedProps = track(() => mergeProps(@avatarApi.getRootProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
