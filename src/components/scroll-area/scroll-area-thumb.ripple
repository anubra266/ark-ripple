import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useScrollAreaContext } from './use-scroll-area-context';
import { useScrollAreaScrollbarContext } from './use-scroll-area-scrollbar-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ScrollAreaThumbBaseProps extends PolymorphicProps<'div'> {}
export interface ScrollAreaThumbProps extends HTMLProps<'div'>, ScrollAreaThumbBaseProps {}

export component ScrollAreaThumb(props: MaybeTracked<ScrollAreaThumbProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const scrollArea = useScrollAreaContext();
  const scrollbarProps = useScrollAreaScrollbarContext();

  let mergedProps = track(
    () => mergeProps(@scrollArea.getThumbProps(@scrollbarProps), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
