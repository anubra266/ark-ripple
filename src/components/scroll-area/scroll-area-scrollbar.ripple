import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useScrollAreaContext } from './use-scroll-area-context';
import { ScrollAreaScrollbarContext } from './use-scroll-area-scrollbar-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ScrollAreaScrollbarBaseProps extends PolymorphicProps<'div'> {
orientation?: 'horizontal' | 'vertical';
}
export interface ScrollAreaScrollbarProps extends HTMLProps<'div'>, ScrollAreaScrollbarBaseProps {}

export component ScrollAreaScrollbar(props: MaybeTracked<ScrollAreaScrollbarProps>) {
  const [children, orientation, localProps] = trackSplit(props, ['children', 'orientation']);
  const scrollArea = useScrollAreaContext();

  const scrollbarProps = track(() => ({ orientation: @orientation }));

  ScrollAreaScrollbarContext.set(scrollbarProps);

  let mergedProps = track(
    () => mergeProps(@scrollArea.getScrollbarProps(@scrollbarProps), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
