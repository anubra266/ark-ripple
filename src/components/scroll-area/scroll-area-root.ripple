import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { ScrollAreaApiContext } from './use-scroll-area-context';
import { useScrollArea, type UseScrollAreaProps } from './use-scroll-area.ripple';
import { splitScrollAreaProps } from './split-scroll-area-props.ripple';
import { ark } from '../factory';

export interface ScrollAreaRootBaseProps extends UseScrollAreaProps {
	children?: any;
	[key: string]: any;
}
export type ScrollAreaRootProps = ScrollAreaRootBaseProps;

export component ScrollAreaRoot(props: ScrollAreaRootProps) {
	const [children, rest] = trackSplit(props, ['children']);
	const [scrollAreaProps, localProps] = splitScrollAreaProps(@rest);
	const scrollArea = useScrollArea(scrollAreaProps);

	ScrollAreaApiContext.set(scrollArea);

	let mergedProps = track(() => mergeProps(@scrollArea.getRootProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
