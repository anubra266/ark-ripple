import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useComboboxContext } from './use-combobox-context';
import { ark } from '../factory';

export interface ComboboxClearTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type ComboboxClearTriggerProps = ComboboxClearTriggerBaseProps;

export component ComboboxClearTrigger(props: ComboboxClearTriggerProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const combobox = useComboboxContext();

  let mergedProps = track(() => mergeProps(@combobox.getClearTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
