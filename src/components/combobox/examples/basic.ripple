import { Combobox, useListCollection } from 'ark-ripple/combobox';
import { useFilter } from 'ark-ripple/locale';
import { Portal } from 'ark-ripple/portal';
import { Check, ChevronsUpDown, X } from 'lucide-ripple';
import styles from 'styles/combobox.module.css';

export component Basic() {
  const filterApi = useFilter({ sensitivity: 'base' });

  let { collection, filter } = useListCollection(
    {
      initialItems: [
        { label: 'Apple', value: 'apple' },
        { label: 'Banana', value: 'banana' },
        { label: 'Orange', value: 'orange' },
        { label: 'Mango', value: 'mango' },
        { label: 'Pineapple', value: 'pineapple' },
        { label: 'Strawberry', value: 'strawberry' },
      ],
      filter: @filterApi.contains,
    },
  );

  <Combobox.Root
    class={styles.Root}
    {collection}
    onInputValueChange={(details) => {
      filter(details.inputValue);
    }}
  >
    <Combobox.Label class={styles.Label}>{'Favorite Fruit'}</Combobox.Label>
    <Combobox.Control class={styles.Control}>
      <Combobox.Input class={styles.Input} placeholder="e.g. Apple" />
      <div class={styles.Indicators}>
        <Combobox.ClearTrigger class={styles.ClearTrigger}>
          <X />
        </Combobox.ClearTrigger>
        <Combobox.Trigger class={styles.Trigger}>
          <ChevronsUpDown />
        </Combobox.Trigger>
      </div>
    </Combobox.Control>
    <Portal>
      <Combobox.Positioner>
        <Combobox.Content class={styles.Content}>
          for (const item of @collection.items; key item.value) {
            <Combobox.Item class={styles.Item} {item}>
              <Combobox.ItemText class={styles.ItemText}>{item.label}</Combobox.ItemText>
              <Combobox.ItemIndicator class={styles.ItemIndicator}>
                <Check />
              </Combobox.ItemIndicator>
            </Combobox.Item>
          }
        </Combobox.Content>
      </Combobox.Positioner>
    </Portal>
  </Combobox.Root>
}
