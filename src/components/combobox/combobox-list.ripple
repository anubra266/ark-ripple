import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useComboboxContext } from './use-combobox-context';
import { ark } from '../factory';

export interface ComboboxListBaseProps {
  children?: any;
  [key: string]: any;
}
export type ComboboxListProps = ComboboxListBaseProps;

export component ComboboxList(props: ComboboxListProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const combobox = useComboboxContext();

  let mergedProps = track(() => mergeProps(@combobox.getListProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
