import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useComboboxContext } from './use-combobox-context';
import { useFieldContext } from '../field/use-field-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ComboboxInputBaseProps extends PolymorphicProps<'input'> {}
export interface ComboboxInputProps extends HTMLProps<'input'>, ComboboxInputBaseProps {}

export component ComboboxInput(props: MaybeTracked<ComboboxInputProps>) {
  const [localProps] = trackSplit(props, []);
  const combobox = useComboboxContext();
  const field = useFieldContext();

  let mergedProps = track(() => mergeProps(@combobox.getInputProps(), @localProps));

  <ark.input aria-describedby={@field?.ariaDescribedby} {...@mergedProps} />
}
