import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useComboboxContext } from './use-combobox-context';
import { usePresenceContext } from '../presence';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ComboboxPositionerBaseProps extends PolymorphicProps<'div'> {}
export interface ComboboxPositionerProps extends HTMLProps<'div'>, ComboboxPositionerBaseProps {}

export component ComboboxPositioner(props: MaybeTracked<ComboboxPositionerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const combobox = useComboboxContext();
  const presence = usePresenceContext();

  let mergedProps = track(() => mergeProps(@combobox.getPositionerProps(), @localProps));

  if (!@presence.unmounted) {
    <ark.div {...@mergedProps}>
      <@children />
    </ark.div>
  }
}
