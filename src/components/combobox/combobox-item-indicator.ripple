import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useComboboxContext } from './use-combobox-context';
import { useComboboxItemPropsContext } from './use-combobox-item-props-context';
import { ark } from '../factory';

export interface ComboboxItemIndicatorBaseProps {
  children?: any;
  [key: string]: any;
}
export type ComboboxItemIndicatorProps = ComboboxItemIndicatorBaseProps;

export component ComboboxItemIndicator(props: ComboboxItemIndicatorProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const combobox = useComboboxContext();
  const itemProps = useComboboxItemPropsContext();

  let mergedProps = track(
    () => mergeProps(@combobox.getItemIndicatorProps(@itemProps), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
