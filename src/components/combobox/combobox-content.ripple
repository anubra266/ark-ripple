import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useComboboxContext } from './use-combobox-context';
import { usePresenceContext } from '../presence';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ComboboxContentBaseProps extends PolymorphicProps<'div'> {}
export interface ComboboxContentProps extends HTMLProps<'div'>, ComboboxContentBaseProps {}

export component ComboboxContent(props: MaybeTracked<ComboboxContentProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const combobox = useComboboxContext();
  const presence = usePresenceContext();

  let mergedProps = track(
    () => mergeProps(@combobox.getContentProps(), @presence.getPresenceProps(), @localProps),
  );

  if (!@presence.unmounted) {
    <ark.div
      {...@mergedProps}
      {ref (el: HTMLDivElement) => {
        @presence.setNode(el);
      }}
    >
      <@children />
    </ark.div>
  }
}
