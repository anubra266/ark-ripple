import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useComboboxContext } from './use-combobox-context';
import { ark } from '../factory';

export interface ComboboxLabelBaseProps {
	children?: any;
	[key: string]: any;
}
export type ComboboxLabelProps = ComboboxLabelBaseProps;

export component ComboboxLabel(props: ComboboxLabelProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const combobox = useComboboxContext();

	let mergedProps = track(() => mergeProps(@combobox.getLabelProps(), @localProps));

	<ark.label {...@mergedProps}>
		<@children />
	</ark.label>
}
