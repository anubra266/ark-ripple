import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { ComboboxApiContext } from './use-combobox-context';
import { PresenceApiContext } from '../presence/use-presence-context';
import { splitPresenceProps } from '../presence/split-presence-props.ripple';
import { usePresence } from '../presence/use-presence.ripple';
import { useCombobox, type UseComboboxProps } from './use-combobox.ripple';
import { splitComboboxProps } from './split-combobox-props.ripple';
import type { UsePresenceProps } from '../presence/use-presence.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ComboboxRootBaseProps<T = any> extends PolymorphicProps<'div'>, UseComboboxProps<
  T
>, UsePresenceProps {}
export interface ComboboxRootProps<T = any> extends HTMLProps<'div'>, ComboboxRootBaseProps<T> {}

export component ComboboxRoot(props: MaybeTracked<ComboboxRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [presenceProps, comboboxProps] = splitPresenceProps(@rest);
  const [useComboboxPropsVal, localProps] = splitComboboxProps(@comboboxProps);

  const combobox = useCombobox(useComboboxPropsVal);
  const present = track(() => @combobox.open);

  let presence = usePresence({ present, ...@presenceProps });
  let mergedProps = track(() => mergeProps(@combobox.getRootProps(), @localProps));

  ComboboxApiContext.set(combobox);
  PresenceApiContext.set(presence);

  <ark.div {...@mergedProps}>
    <props.children />
  </ark.div>
}
