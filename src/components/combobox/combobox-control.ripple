import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useComboboxContext } from './use-combobox-context';
import { ark } from '../factory';

export interface ComboboxControlBaseProps {
	children?: any;
	[key: string]: any;
}
export type ComboboxControlProps = ComboboxControlBaseProps;

export component ComboboxControl(props: ComboboxControlProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const combobox = useComboboxContext();

	let mergedProps = track(() => mergeProps(@combobox.getControlProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
