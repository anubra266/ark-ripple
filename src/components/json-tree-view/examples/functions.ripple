import { JsonTreeView } from 'ark-ripple/json-tree-view';
import { ChevronRight } from 'lucide-ripple';
import styles from 'styles/json-tree-view.module.css';

const data = [
  function sum(a: number, b: number) {
    return a + b;
  },
  async (promises: Promise<any>[]) => await Promise.all(promises),
  function* generator(a: number) {
    while (a > 0) {
      yield a - 1;
    }
  },
];

export component Functions() {
  <JsonTreeView.Root defaultExpandedDepth={1} class={styles.Root} {data}>
    <JsonTreeView.Tree class={styles.Tree} arrow={ChevronRight} />
  </JsonTreeView.Root>
}
