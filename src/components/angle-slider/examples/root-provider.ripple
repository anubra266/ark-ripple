import { AngleSlider } from 'ark-ripple/angle-slider';
import { useAngleSlider } from 'ark-ripple/angle-slider';
import button from 'styles/button.module.css';
import styles from 'styles/angle-slider.module.css';

const markers = [0, 45, 90, 135, 180, 225, 270, 315];

export component RootProvider() {
  const angleSlider = useAngleSlider();

  <div class="vstack">
    <button
      class={button.Root}
      onClick={() => {
        @angleSlider.setValue(90);
      }}
    >
      {'Set to 90'}
    </button>

    <AngleSlider.RootProvider value={angleSlider} class={styles.Root}>
      <AngleSlider.Label class={styles.Label}>{'Rotation'}</AngleSlider.Label>
      <AngleSlider.Control class={styles.Control}>
        <AngleSlider.MarkerGroup class={styles.MarkerGroup}>
          for (const value of markers; key value) {
            <AngleSlider.Marker {value} class={styles.Marker} />
          }
        </AngleSlider.MarkerGroup>
        <AngleSlider.Thumb class={styles.Thumb} />
      </AngleSlider.Control>
      <AngleSlider.ValueText class={styles.ValueText} />
      <AngleSlider.HiddenInput />
    </AngleSlider.RootProvider>
  </div>
}
