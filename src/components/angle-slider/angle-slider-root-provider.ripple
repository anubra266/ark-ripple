import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { AngleSliderApiContext } from './use-angle-slider-context';
import type { UseAngleSliderReturn } from './use-angle-slider.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface AngleSliderRootProviderBaseProps extends PolymorphicProps<'div'> {
value: UseAngleSliderReturn;
}
export interface AngleSliderRootProviderProps extends HTMLProps<'div'>, AngleSliderRootProviderBaseProps {}

export component AngleSliderRootProvider(props: MaybeTracked<AngleSliderRootProviderProps>) {
  const [angleSlider, children, rest] = trackSplit(props, ['value', 'children']);

  AngleSliderApiContext.set(angleSlider);

  let mergedProps = track(() => mergeProps(@angleSlider.getRootProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
