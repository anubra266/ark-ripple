import { mergeProps } from 'zag-ripple';
import { track } from 'ripple';
import { useAngleSliderContext } from './use-angle-slider-context';
import { ark } from '../factory';

export interface AngleSliderHiddenInputBaseProps {
	[key: string]: any;
}
export type AngleSliderHiddenInputProps = AngleSliderHiddenInputBaseProps;

export component AngleSliderHiddenInput(props: AngleSliderHiddenInputProps) {
	const angleSlider = useAngleSliderContext();

	let mergedProps = track(() => mergeProps(@angleSlider.getHiddenInputProps(), props));

	<ark.input {...@mergedProps} />
}
