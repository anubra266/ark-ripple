import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useProgressContext } from './use-progress-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ProgressLabelBaseProps extends PolymorphicProps<'label'> {}
export interface ProgressLabelProps extends HTMLProps<'label'>, ProgressLabelBaseProps {}

export component ProgressLabel(props: MaybeTracked<ProgressLabelProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const progress = useProgressContext();

  let mergedProps = track(() => mergeProps(@progress.getLabelProps(), @localProps));

  <ark.label {...@mergedProps}>
    <@children />
  </ark.label>
}
