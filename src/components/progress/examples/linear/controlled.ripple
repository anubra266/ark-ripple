import { Progress } from 'ark-ripple/progress';
import { track } from 'ripple';
import styles from 'styles/progress.module.css';

export component Controlled() {
  let value = track<number | null>(42);

  <Progress.Root class={styles.Root} value={value} onValueChange={(e) => { @value = e.value }}>
    <Progress.Label class={styles.Label}>{'Label'}</Progress.Label>
    <Progress.ValueText class={styles.ValueText} />
    <Progress.Track class={styles.Track}>
      <Progress.Range class={styles.Range} />
    </Progress.Track>
  </Progress.Root>
}
