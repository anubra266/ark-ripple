import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { RadioGroupApiContext } from './use-radio-group-context';
import { useRadioGroup, type UseRadioGroupProps } from './use-radio-group.ripple';
import { splitRadioGroupProps } from './split-radio-group-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface RadioGroupRootBaseProps extends PolymorphicProps<'div'>, UseRadioGroupProps {}
export interface RadioGroupRootProps extends HTMLProps<'div'>, RadioGroupRootBaseProps {}

export component RadioGroupRoot(props: MaybeTracked<RadioGroupRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [radioGroupProps, localProps] = splitRadioGroupProps(@rest);
  const radioGroup = useRadioGroup(radioGroupProps);

  RadioGroupApiContext.set(radioGroup);

  let mergedProps = track(() => mergeProps(@radioGroup.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
