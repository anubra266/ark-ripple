import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useRadioGroupContext } from './use-radio-group-context';
import { useRadioGroupItemPropsContext } from './use-radio-group-item-props-context';
import { ark } from '../factory';

export interface RadioGroupItemControlBaseProps {
  children?: any;
  [key: string]: any;
}
export type RadioGroupItemControlProps = RadioGroupItemControlBaseProps;

export component RadioGroupItemControl(props: RadioGroupItemControlProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const radioGroup = useRadioGroupContext();
  const itemProps = useRadioGroupItemPropsContext();

  let mergedProps = track(
    () => mergeProps(@radioGroup.getItemControlProps(@itemProps), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
