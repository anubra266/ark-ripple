import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { RadioGroupApiContext } from './use-radio-group-context';
import type { UseRadioGroupReturn } from './use-radio-group.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface RadioGroupRootProviderBaseProps extends PolymorphicProps<'div'> {
value: UseRadioGroupReturn;
}
export interface RadioGroupRootProviderProps extends HTMLProps<'div'>, RadioGroupRootProviderBaseProps {}

export component RadioGroupRootProvider(props: MaybeTracked<RadioGroupRootProviderProps>) {
  const [radioGroup, children, rest] = trackSplit(props, ['value', 'children']);

  RadioGroupApiContext.set(radioGroup);

  let mergedProps = track(() => mergeProps(@radioGroup.getRootProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
