import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useRadioGroupContext } from './use-radio-group-context';
import { ark } from '../factory';

export interface RadioGroupLabelBaseProps {
  children?: any;
  [key: string]: any;
}
export type RadioGroupLabelProps = RadioGroupLabelBaseProps;

export component RadioGroupLabel(props: RadioGroupLabelProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const radioGroup = useRadioGroupContext();

  let mergedProps = track(() => mergeProps(@radioGroup.getLabelProps(), @localProps));

  <ark.label {...@mergedProps}>
    <@children />
  </ark.label>
}
