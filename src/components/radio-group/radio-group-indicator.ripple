import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useRadioGroupContext } from './use-radio-group-context';
import { ark } from '../factory';

export interface RadioGroupIndicatorBaseProps {
	children?: any;
	[key: string]: any;
}
export type RadioGroupIndicatorProps = RadioGroupIndicatorBaseProps;

export component RadioGroupIndicator(props: RadioGroupIndicatorProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const radioGroup = useRadioGroupContext();

	let mergedProps = track(() => mergeProps(@radioGroup.getIndicatorProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
