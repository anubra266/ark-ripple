import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useRadioGroupContext } from './use-radio-group-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface RadioGroupIndicatorBaseProps extends PolymorphicProps<'div'> {}
export interface RadioGroupIndicatorProps extends HTMLProps<'div'>, RadioGroupIndicatorBaseProps {}

export component RadioGroupIndicator(props: MaybeTracked<RadioGroupIndicatorProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const radioGroup = useRadioGroupContext();

  let mergedProps = track(() => mergeProps(@radioGroup.getIndicatorProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
