import { PinInput, usePinInput } from 'ark-ripple/pin-input';
import styles from 'styles/pin-input.module.css';

export component RootProvider() {
  const pinInput = usePinInput({ onValueComplete: (e: PinInput.ValueChangeDetails) => alert(e.valueAsString) });

  <div class="stack">
    <button onClick={() => @pinInput.focus()}>{'Focus'}</button>

    <PinInput.RootProvider value={pinInput} class={styles.Root}>
      <PinInput.Label class={styles.Label}>{'Label'}</PinInput.Label>
      <PinInput.Control class={styles.Control}>
        for (const index of [0, 1, 2]; key index) {
          <PinInput.Input class={styles.Input} {index} />
        }
      </PinInput.Control>
      <PinInput.HiddenInput />
    </PinInput.RootProvider>
  </div>
}
