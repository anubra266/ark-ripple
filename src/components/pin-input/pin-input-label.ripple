import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { usePinInputContext } from './use-pin-input-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface PinInputLabelBaseProps extends PolymorphicProps<'label'> {}
export interface PinInputLabelProps extends HTMLProps<'label'>, PinInputLabelBaseProps {}

export component PinInputLabel(props: MaybeTracked<PinInputLabelProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const pinInput = usePinInputContext();

  let mergedProps = track(() => mergeProps(@pinInput.getLabelProps(), @localProps));

  <ark.label {...@mergedProps}>
    <@children />
  </ark.label>
}
