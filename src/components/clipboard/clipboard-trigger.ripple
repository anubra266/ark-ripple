import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { useClipboardContext } from './use-clipboard-context';
import { ark } from '../factory';

export interface ClipboardTriggerBaseProps {
  children?: any;
  [key: string]: any;
}
export type ClipboardTriggerProps = ClipboardTriggerBaseProps;

export component ClipboardTrigger(props: ClipboardTriggerProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const clipboard = useClipboardContext();

  const mergedProps = track(() => mergeProps(@clipboard.getTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
