import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { useClipboardContext } from './use-clipboard-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ClipboardIndicatorBaseProps extends PolymorphicProps<'div'> {
  /** Content to show when copied */
  copied?: any;
}
export interface ClipboardIndicatorProps extends HTMLProps<'div'>, ClipboardIndicatorBaseProps {}

export component ClipboardIndicator(props: MaybeTracked<ClipboardIndicatorProps>) {
  const [copied, children, localProps] = trackSplit(props, ['copied', 'children']);
  const clipboard = useClipboardContext();

  const mergedProps = track(
    () => mergeProps(@clipboard.getIndicatorProps({ copied: @clipboard.copied }), @localProps),
  );

  <ark.div {...@mergedProps}>
    if (@clipboard.copied) {
      <@copied />
    } else {
      <@children />
    }
  </ark.div>
}
