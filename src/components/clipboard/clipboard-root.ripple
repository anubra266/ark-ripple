import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { ClipboardApiContext } from './use-clipboard-context';
import { useClipboard, type UseClipboardProps } from './use-clipboard.ripple';
import { splitClipboardProps } from './split-clipboard-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ClipboardRootBaseProps extends PolymorphicProps<'div'>, UseClipboardProps {}
export interface ClipboardRootProps extends HTMLProps<'div'>, ClipboardRootBaseProps {}

export component ClipboardRoot(props: MaybeTracked<ClipboardRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [useClipboardProps, localProps] = splitClipboardProps(@rest);
  const clipboard = useClipboard(useClipboardProps);

  ClipboardApiContext.set(clipboard);

  const mergedProps = track(() => mergeProps(@clipboard.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
