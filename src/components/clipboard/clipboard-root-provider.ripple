import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { ClipboardApiContext } from './use-clipboard-context';
import type { UseClipboardReturn } from './use-clipboard.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ClipboardRootProviderBaseProps extends PolymorphicProps<'div'> {
/** The clipboard machine api */
  value: UseClipboardReturn;
}
export interface ClipboardRootProviderProps extends HTMLProps<'div'>, ClipboardRootProviderBaseProps {}

export component ClipboardRootProvider(props: MaybeTracked<ClipboardRootProviderProps>) {
  const [clipboard, children, rest] = trackSplit(props, ['value', 'children']);

  ClipboardApiContext.set(clipboard);

  const mergedProps = track(() => mergeProps(@clipboard.getRootProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
