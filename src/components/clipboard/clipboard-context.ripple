import { trackSplit } from 'ripple';
import { useClipboardContext, type UseClipboardContext } from './use-clipboard-context';

export interface ClipboardContextProps {
	children: (context: UseClipboardContext) => any;
}

export component ClipboardContext(props: ClipboardContextProps) {
	const [children] = trackSplit(props, ['children']);
	const context = useClipboardContext();

	<@children {context} />
}
