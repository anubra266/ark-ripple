import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { useClipboardContext } from './use-clipboard-context';
import { ark } from '../factory';

export interface ClipboardLabelBaseProps {
	children?: any;
	[key: string]: any;
}
export type ClipboardLabelProps = ClipboardLabelBaseProps;

export component ClipboardLabel(props: ClipboardLabelProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const clipboard = useClipboardContext();

	const mergedProps = track(() => mergeProps(@clipboard.getLabelProps(), @localProps));

	<ark.label {...@mergedProps}>
		<@children />
	</ark.label>
}
