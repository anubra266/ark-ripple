import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { useClipboardContext } from './use-clipboard-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ClipboardLabelBaseProps extends PolymorphicProps<'label'> {}
export interface ClipboardLabelProps extends HTMLProps<'label'>, ClipboardLabelBaseProps {}

export component ClipboardLabel(props: MaybeTracked<ClipboardLabelProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const clipboard = useClipboardContext();

  const mergedProps = track(() => mergeProps(@clipboard.getLabelProps(), @localProps));

  <ark.label {...@mergedProps}>
    <@children />
  </ark.label>
}
