import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTourContext } from './use-tour-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TourCloseTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface TourCloseTriggerProps extends HTMLProps<'button'>, TourCloseTriggerBaseProps {}

export component TourCloseTrigger(props: MaybeTracked<TourCloseTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const api = useTourContext();

  let mergedProps = track(() => mergeProps(@api.getCloseTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
