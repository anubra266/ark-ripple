import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTourContext } from './use-tour-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TourTitleBaseProps extends PolymorphicProps<'h2'> {}
export interface TourTitleProps extends HTMLProps<'h2'>, TourTitleBaseProps {}

export component TourTitle(props: MaybeTracked<TourTitleProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const api = useTourContext();

  let mergedProps = track(() => mergeProps(@api.getTitleProps(), @localProps));

  <ark.h2 {...@mergedProps}>
    if (@children) {
      <@children />
    } else {
      {@api.step?.title}
    }
  </ark.h2>
}
