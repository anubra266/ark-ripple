import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTourContext } from './use-tour-context';
import { usePresence } from '../presence/use-presence.ripple';
import { useRenderStrategyContext } from '../../utils/render-strategy.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TourBackdropBaseProps extends PolymorphicProps<'div'> {}
export interface TourBackdropProps extends HTMLProps<'div'>, TourBackdropBaseProps {}

export component TourBackdrop(props: MaybeTracked<TourBackdropProps>) {
  const [localProps] = trackSplit(props, []);
  const api = useTourContext();
  const renderStrategyProps = useRenderStrategyContext();

  const present = track(() => @api.open);
  const presence = usePresence({ present, ...@renderStrategyProps });

  let mergedProps = track(
    () => mergeProps(@api.getBackdropProps(), @presence.getPresenceProps(), @localProps),
  );

  if (!@presence.unmounted) {
    <ark.div
      {...@mergedProps}
      hidden={!@api.step?.backdrop}
      {ref (el: HTMLDivElement) => {
        @presence.setNode(el);
      }}
    />
  }
}
