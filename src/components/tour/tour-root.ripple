import { trackSplit, track } from 'ripple';
import type { MaybeTracked } from '../../types';
import { TourApiContext } from './use-tour-context';
import { PresenceApiContext } from '../presence/use-presence-context';
import { splitPresenceProps } from '../presence/split-presence-props.ripple';
import { usePresence, type UsePresenceProps } from '../presence/use-presence.ripple';
import type { UseTourReturn } from './use-tour.ripple';
import {
  splitRenderStrategyProps,
  RenderStrategyContext,
} from '../../utils/render-strategy.ripple';

export interface TourRootBaseProps extends UsePresenceProps {
  tour: UseTourReturn;
  children?: any;
}
export interface TourRootProps extends TourRootBaseProps {}

export component TourRoot(props: MaybeTracked<TourRootProps>) {
  const [children, value, rest] = trackSplit(props, ['children', 'tour']);
  const [presenceProps] = splitPresenceProps(@rest);
  const [renderStrategyProps] = splitRenderStrategyProps(@presenceProps);

  const present = track(() => @value.open);
  const presence = usePresence({ present, ...@presenceProps });

  TourApiContext.set(value);
  RenderStrategyContext.set(renderStrategyProps);
  PresenceApiContext.set(presence);

  <@children />
}
