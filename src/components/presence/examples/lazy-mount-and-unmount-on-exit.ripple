import { track } from 'ripple';
import { Presence } from 'ark-ripple/presence';
import button from 'styles/button.module.css';
import styles from 'styles/presence.module.css';

export component LazyMountAndUnmountOnExit() {
  let present = track(false);

  <div class="stack">
    <button
      class={button.Root}
      onClick={() => {
        @present = !@present;
      }}
    >
      {'Toggle'}
    </button>
    <Presence class={styles.Box} lazyMount unmountOnExit {present}>{'Lazy + Unmount'}</Presence>
  </div>
}
