import { createSplitProps } from '../../utils/create-split-props.ripple';
import type { UsePresenceProps } from './use-presence.ripple';

const splitProps = createSplitProps<UsePresenceProps>();

export function splitPresenceProps<T extends UsePresenceProps & Record<string, any>>(props: T) {
  return splitProps(props, [
    'immediate',
    'lazyMount',
    'onExitComplete',
    'present',
    'skipAnimationOnMount',
    'unmountOnExit',
  ]);
}
