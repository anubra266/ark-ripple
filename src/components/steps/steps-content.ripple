import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useStepsContext } from './use-steps-context';
import type { ItemProps } from '@zag-js/steps';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface StepsContentBaseProps extends PolymorphicProps<'div'>, ItemProps {}
export interface StepsContentProps extends HTMLProps<'div'>, StepsContentBaseProps {}

export component StepsContent(props: MaybeTracked<StepsContentProps>) {
  const [children, index, localProps] = trackSplit(props, ['children', 'index']);
  const stepsApi = useStepsContext();

  let mergedProps = track(
    () => mergeProps(@stepsApi.getContentProps({ index: @index }), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
