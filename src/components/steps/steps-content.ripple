import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useStepsContext } from './use-steps-context';
import type { ItemProps } from '@zag-js/steps';
import { ark } from '../factory';

export interface StepsContentBaseProps extends ItemProps {
	children?: any;
	[key: string]: any;
}
export type StepsContentProps = StepsContentBaseProps;

export component StepsContent(props: StepsContentProps) {
	const [children, index, localProps] = trackSplit(props, ['children', 'index']);
	const stepsApi = useStepsContext();

	let mergedProps = track(
		() => mergeProps(@stepsApi.getContentProps({ index: @index }), @localProps),
	);

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
