import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { StepsApiContext } from './use-steps-context';
import type { UseStepsReturn } from './use-steps.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface StepsRootProviderBaseProps extends PolymorphicProps<'div'> {
  value: UseStepsReturn;
}
export interface StepsRootProviderProps extends HTMLProps<'div'>, StepsRootProviderBaseProps {}

export component StepsRootProvider(props: MaybeTracked<StepsRootProviderProps>) {
  const [stepsApi, children, localProps] = trackSplit(props, ['value', 'children']);

  StepsApiContext.set(stepsApi);

  let mergedProps = track(() => mergeProps(@stepsApi.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
