import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { StepsApiContext } from './use-steps-context';
import { useSteps, type UseStepsProps } from './use-steps.ripple';
import { splitStepsProps } from './split-steps-props.ripple';
import { ark } from '../factory';

export interface StepsRootBaseProps extends UseStepsProps {
	children?: any;
	[key: string]: any;
}
export type StepsRootProps = StepsRootBaseProps;

export component StepsRoot(props: StepsRootProps) {
	const [children, rest] = trackSplit(props, ['children']);
	const [stepsProps, localProps] = splitStepsProps(@rest);
	const stepsApi = useSteps(stepsProps);

	StepsApiContext.set(stepsApi);

	let mergedProps = track(() => mergeProps(@stepsApi.getRootProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
