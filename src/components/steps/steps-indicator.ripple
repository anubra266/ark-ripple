import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useStepsContext } from './use-steps-context';
import { useStepsItemPropsContext } from './use-steps-item-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface StepsIndicatorBaseProps extends PolymorphicProps<'div'> {}
export interface StepsIndicatorProps extends HTMLProps<'div'>, StepsIndicatorBaseProps {}

export component StepsIndicator(props: MaybeTracked<StepsIndicatorProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const stepsApi = useStepsContext();
  const itemProps = useStepsItemPropsContext();

  let mergedProps = track(() => mergeProps(@stepsApi.getIndicatorProps(@itemProps), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
