import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useStepsContext } from './use-steps-context';
import { ark } from '../factory';

export interface StepsNextTriggerBaseProps {
	children?: any;
	[key: string]: any;
}
export type StepsNextTriggerProps = StepsNextTriggerBaseProps;

export component StepsNextTrigger(props: StepsNextTriggerProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const stepsApi = useStepsContext();

	let mergedProps = track(() => mergeProps(@stepsApi.getNextTriggerProps(), @localProps));

	<ark.button {...@mergedProps}>
		<@children />
	</ark.button>
}
