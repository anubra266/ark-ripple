import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useStepsContext } from './use-steps-context';
import { ark } from '../factory';

export interface StepsProgressBaseProps {
	children?: any;
	[key: string]: any;
}
export type StepsProgressProps = StepsProgressBaseProps;

export component StepsProgress(props: StepsProgressProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const stepsApi = useStepsContext();

	let mergedProps = track(() => mergeProps(@stepsApi.getProgressProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
