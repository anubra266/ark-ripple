import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useStepsContext } from './use-steps-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface StepsCompletedContentBaseProps extends PolymorphicProps<'div'> {}
export interface StepsCompletedContentProps extends HTMLProps<
  'div'
>, StepsCompletedContentBaseProps {}

export component StepsCompletedContent(props: MaybeTracked<StepsCompletedContentProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const stepsApi = useStepsContext();

  let mergedProps = track(
    () => mergeProps(@stepsApi.getContentProps({ index: @stepsApi.count }), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
