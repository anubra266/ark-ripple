import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useStepsContext } from './use-steps-context';
import { ark } from '../factory';

export interface StepsPrevTriggerBaseProps {
	children?: any;
	[key: string]: any;
}
export type StepsPrevTriggerProps = StepsPrevTriggerBaseProps;

export component StepsPrevTrigger(props: StepsPrevTriggerProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const stepsApi = useStepsContext();

	let mergedProps = track(() => mergeProps(@stepsApi.getPrevTriggerProps(), @localProps));

	<ark.button {...@mergedProps}>
		<@children />
	</ark.button>
}
