import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useStepsContext } from './use-steps-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface StepsPrevTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface StepsPrevTriggerProps extends HTMLProps<'button'>, StepsPrevTriggerBaseProps {}

export component StepsPrevTrigger(props: MaybeTracked<StepsPrevTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const stepsApi = useStepsContext();

  let mergedProps = track(() => mergeProps(@stepsApi.getPrevTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
