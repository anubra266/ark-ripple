import { Format } from 'ark-ripple/format';
import styles from 'styles/format.module.css';

export component NumberWithPercentage() {
  <span class={styles.Value}>
    <Format.Number
      value={0.145}
      style="percent"
      maximumFractionDigits={2}
      minimumFractionDigits={2}
    />
  </span>
}
