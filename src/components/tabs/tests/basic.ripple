import { Tabs } from 'ark-ripple/tabs';

const items = [
  { value: 'React' },
  { value: 'Solid' },
  { value: 'Svelte', disabled: true },
  { value: 'Vue' },
];

export component ComponentUnderTest(props: {
  [key: string]: any;
}) {
  <Tabs.Root {...props}>
    <Tabs.List>
      for (const item of items; key item.value) {
        <Tabs.Trigger value={item.value} disabled={item.disabled}>
          {item.value}
          {' Trigger'}
        </Tabs.Trigger>
      }
      <Tabs.Indicator />
    </Tabs.List>
    for (const item of items; key item.value) {
      <Tabs.Content value={item.value}>
        {item.value}
        {' Content'}
      </Tabs.Content>
    }
  </Tabs.Root>
}
