import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useTabsContext } from './use-tabs-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface TabIndicatorBaseProps extends PolymorphicProps<'div'> {}
export interface TabIndicatorProps extends HTMLProps<'div'>, TabIndicatorBaseProps {}

export component TabIndicator(props: MaybeTracked<TabIndicatorProps>) {
  const [localProps] = trackSplit(props, []);
  const api = useTabsContext();

  let mergedProps = track(() => mergeProps(@api.getIndicatorProps(), @localProps));

  <ark.div {...@mergedProps} />
}
