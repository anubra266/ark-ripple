import { trackSplit, effect } from 'ripple';
import { useHighlight, type UseHighlightProps } from './use-highlight.ripple';
import { createSplitProps } from '../../utils/create-split-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface HighlightBaseProps extends PolymorphicProps<'mark'>, UseHighlightProps {}
export interface HighlightProps extends Assign<HTMLProps<'mark'>, HighlightBaseProps> {}

export component Highlight(props: MaybeTracked<HighlightProps>) {
  const [highlightProps, localProps] = createSplitProps<HighlightBaseProps>()(props, [
    'query',
    'text',
    'ignoreCase',
    'matchAll',
    'exactMatch',
  ]);

  effect(() => {
    if (typeof @highlightProps.text !== 'string') {
      throw new Error('[ark-ui/highlight] text must be a string');
    }
  });

  const chunks = useHighlight(highlightProps);

  for (const chunk of @chunks; index i; key i) {
    if (chunk.match) {
      <ark.mark {...@localProps}>{chunk.text}</ark.mark>
    } else {
      {chunk.text}
    }
  }
}
