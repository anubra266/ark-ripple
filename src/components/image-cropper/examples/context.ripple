import { ImageCropper } from 'ark-ripple/image-cropper';
import { ZoomIn, ZoomOut } from 'lucide-ripple';
import button from 'styles/button.module.css';
import styles from 'styles/image-cropper.module.css';

export component Context() {
  <div class={styles.Layout}>
    <ImageCropper.Root class={styles.Root}>
      <ImageCropper.Context>
        component children({ context }) {
          <div class={button.Group}>
            <button type="button" class={button.Root} onClick={() => @context.zoomBy(-0.1)}>
              <ZoomOut />
            </button>
            <span
              style={{
                fontSize: '0.875rem',
                padding: '0 0.5rem',
                minWidth: '3rem',
                textAlign: 'center',
              }}
            >
              {@context.zoom.toFixed(1)}
              {'x'}
            </span>
            <button type="button" class={button.Root} onClick={() => @context.zoomBy(0.1)}>
              <ZoomIn />
            </button>
          </div>
        }
      </ImageCropper.Context>

      <ImageCropper.Viewport class={styles.Viewport}>
        <ImageCropper.Image
          class={styles.Image}
          src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800"
          alt="Sample"
        />
        <ImageCropper.Selection class={styles.Selection}>
          for (const position of ImageCropper.handles; key position) {
            <ImageCropper.Handle class={styles.Handle} {position}>
              <div />
            </ImageCropper.Handle>
          }
          <ImageCropper.Grid class={styles.Grid} axis="horizontal" />
          <ImageCropper.Grid class={styles.Grid} axis="vertical" />
        </ImageCropper.Selection>
      </ImageCropper.Viewport>
    </ImageCropper.Root>
  </div>
}
