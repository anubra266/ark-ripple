import { ImageCropper } from 'ark-ripple/image-cropper';

export component ComponentUnderTest(props: {
  [key: string]: any;
}) {
  <ImageCropper.Root {...props}>
    <ImageCropper.Viewport data-testid="viewport">
      <ImageCropper.Image
        src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800"
        alt="Sample"
      />
      <ImageCropper.Selection data-testid="selection">
        for (const position of ImageCropper.handles; key position) {
          <ImageCropper.Handle {position}>
            <div />
          </ImageCropper.Handle>
        }
        <ImageCropper.Grid axis="horizontal" />
        <ImageCropper.Grid axis="vertical" />
      </ImageCropper.Selection>
    </ImageCropper.Viewport>
  </ImageCropper.Root>
}
