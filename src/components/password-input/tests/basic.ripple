import { PasswordInput } from 'ark-ripple/password-input';
import { Field } from 'ark-ripple/field';

export component ComponentUnderTest(props: {
  [key: string]: any;
}) {
  <PasswordInput.Root {...props}>
    <PasswordInput.Label>{'Password'}</PasswordInput.Label>
    <PasswordInput.Control>
      <PasswordInput.Input />
      <PasswordInput.VisibilityTrigger>
        <PasswordInput.Indicator>
          component fallback() {
            <span>{'Hide'}</span>
          }
          {'Show'}
        </PasswordInput.Indicator>
      </PasswordInput.VisibilityTrigger>
    </PasswordInput.Control>
  </PasswordInput.Root>
}

export component PasswordInputWithField(props: {
  [key: string]: any;
}) {
  <Field.Root {...props}>
    <PasswordInput.Root>
      <PasswordInput.Label>{'Password'}</PasswordInput.Label>
      <PasswordInput.Control>
        <PasswordInput.Input />
        <PasswordInput.VisibilityTrigger>
          <PasswordInput.Indicator>
            component fallback() {
              <span>{'Hide'}</span>
            }
            {'Show'}
          </PasswordInput.Indicator>
        </PasswordInput.VisibilityTrigger>
      </PasswordInput.Control>
    </PasswordInput.Root>
    <Field.HelperText>{'Additional Info'}</Field.HelperText>
    <Field.ErrorText>{'Error Info'}</Field.ErrorText>
  </Field.Root>
}
