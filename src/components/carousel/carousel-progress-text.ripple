import { mergeProps } from 'zag-ripple';
import { trackSplit, track, type Component } from 'ripple';
import { carouselAnatomy } from './carousel.anatomy';
import { useCarouselContext } from './use-carousel-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

const parts = carouselAnatomy.build();

export interface CarouselProgressTextBaseProps extends PolymorphicProps<'span'> {}
export interface CarouselProgressTextProps extends HTMLProps<'span'>, CarouselProgressTextBaseProps {}

export component CarouselProgressText(props: MaybeTracked<CarouselProgressTextProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const carousel = useCarouselContext();

  const progressText = track(() => {
    const currentPage = @carousel.page + 1;
    const totalPages = @carousel.pageSnapPoints.length;
    return `${currentPage} / ${totalPages}`;
  });

  let mergedProps = track(() => mergeProps(parts.progressText.attrs, @rest));

  <ark.span {...@mergedProps}>
    if (@children) {
      <@children />
    } else {
      {@progressText}
    }
  </ark.span>
}
