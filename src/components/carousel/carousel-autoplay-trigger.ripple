import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useCarouselContext } from './use-carousel-context';
import { ark } from '../factory';

export interface CarouselAutoplayTriggerBaseProps {
	children?: any;
	[key: string]: any;
}
export type CarouselAutoplayTriggerProps = CarouselAutoplayTriggerBaseProps;

export component CarouselAutoplayTrigger(props: CarouselAutoplayTriggerProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const carousel = useCarouselContext();

	let mergedProps = track(() => mergeProps(@carousel.getAutoplayTriggerProps(), @localProps));

	<ark.button {...@mergedProps}>
		<@children />
	</ark.button>
}
