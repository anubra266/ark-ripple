import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useCarouselContext } from './use-carousel-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface CarouselAutoplayTriggerBaseProps extends PolymorphicProps<'button'> {}
export interface CarouselAutoplayTriggerProps extends HTMLProps<'button'>, CarouselAutoplayTriggerBaseProps {}

export component CarouselAutoplayTrigger(props: MaybeTracked<CarouselAutoplayTriggerProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const carousel = useCarouselContext();

  let mergedProps = track(() => mergeProps(@carousel.getAutoplayTriggerProps(), @localProps));

  <ark.button {...@mergedProps}>
    <@children />
  </ark.button>
}
