import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { CarouselApiContext } from './use-carousel-context';
import { useCarousel, type UseCarouselProps } from './use-carousel.ripple';
import { splitCarouselProps } from './split-carousel-props.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface CarouselRootBaseProps extends PolymorphicProps<'div'>, UseCarouselProps {}
export interface CarouselRootProps extends HTMLProps<'div'>, CarouselRootBaseProps {}

export component CarouselRoot(props: MaybeTracked<CarouselRootProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const [useCarouselProps, localProps] = splitCarouselProps(@rest);
  const carousel = useCarousel(useCarouselProps);

  CarouselApiContext.set(carousel);

  let mergedProps = track(() => mergeProps(@carousel.getRootProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
