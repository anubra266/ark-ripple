import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useCarouselContext } from './use-carousel-context';
import { ark } from '../factory';

export interface CarouselItemGroupBaseProps {
  children?: any;
  [key: string]: any;
}
export type CarouselItemGroupProps = CarouselItemGroupBaseProps;

export component CarouselItemGroup(props: CarouselItemGroupProps) {
  const [children, localProps] = trackSplit(props, ['children']);
  const carousel = useCarouselContext();

  let mergedProps = track(() => mergeProps(@carousel.getItemGroupProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
