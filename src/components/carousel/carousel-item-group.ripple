import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useCarouselContext } from './use-carousel-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface CarouselItemGroupBaseProps extends PolymorphicProps<'div'> {}
export interface CarouselItemGroupProps extends HTMLProps<'div'>, CarouselItemGroupBaseProps {}

export component CarouselItemGroup(props: MaybeTracked<CarouselItemGroupProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const carousel = useCarouselContext();

  let mergedProps = track(() => mergeProps(@carousel.getItemGroupProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
