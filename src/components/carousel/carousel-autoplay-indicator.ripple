import { mergeProps } from 'zag-ripple';
import { trackSplit, track, type Component } from 'ripple';
import { carouselAnatomy } from './carousel.anatomy';
import { useCarouselContext } from './use-carousel-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

const parts = carouselAnatomy.build();

export interface CarouselAutoplayIndicatorBaseProps extends PolymorphicProps<'span'> {
/**
 * The fallback snippet to render when autoplay is paused.
*/
  fallback?: Component;
}
export interface CarouselAutoplayIndicatorProps extends HTMLProps<'span'>, CarouselAutoplayIndicatorBaseProps {}

export component CarouselAutoplayIndicator(props: MaybeTracked<CarouselAutoplayIndicatorProps>) {
  const [children, fallback, rest] = trackSplit(props, ['children', 'fallback']);
  const carousel = useCarouselContext();

  let mergedProps = track(() => mergeProps(parts.autoplayIndicator.attrs, @rest));

  <ark.span {...@mergedProps}>
    if (@carousel.isPlaying) {
      <@children />
    } else {
      <@fallback />
    }
  </ark.span>
}
