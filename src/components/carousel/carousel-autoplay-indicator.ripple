import { mergeProps } from 'zag-ripple';
import { trackSplit, track, type Component } from 'ripple';
import { carouselAnatomy } from './carousel.anatomy';
import { useCarouselContext } from './use-carousel-context';
import { ark } from '../factory';

const parts = carouselAnatomy.build();

export interface CarouselAutoplayIndicatorBaseProps {
	/**
 * The fallback snippet to render when autoplay is paused.
*/
	fallback?: Component;
	[key: string]: any;
}
export interface CarouselAutoplayIndicatorProps extends CarouselAutoplayIndicatorBaseProps {
	children?: Component;
}

export component CarouselAutoplayIndicator(props: CarouselAutoplayIndicatorProps) {
	const [children, fallback, rest] = trackSplit(props, ['children', 'fallback']);
	const carousel = useCarouselContext();

	let mergedProps = track(() => mergeProps(parts.autoplayIndicator.attrs, @rest));

	<ark.span {...@mergedProps}>
		if (@carousel.isPlaying) {
			<@children />
		} else {
			<@fallback />
		}
	</ark.span>
}
