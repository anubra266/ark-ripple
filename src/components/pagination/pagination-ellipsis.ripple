import type { EllipsisProps } from '@zag-js/pagination';
import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { usePaginationContext } from './use-pagination-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface PaginationEllipsisBaseProps extends EllipsisProps, PolymorphicProps<'div'> {}
export interface PaginationEllipsisProps extends HTMLProps<'div'>, PaginationEllipsisBaseProps {}

export component PaginationEllipsis(props: MaybeTracked<PaginationEllipsisProps>) {
  const [children, index, localProps] = trackSplit(props, ['children', 'index']);
  const pagination = usePaginationContext();

  let mergedProps = track(
    () => mergeProps(@pagination.getEllipsisProps({ index: @index }), @localProps),
  );

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
