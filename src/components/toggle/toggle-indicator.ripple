import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useToggleContext } from './use-toggle-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface ToggleIndicatorBaseProps extends PolymorphicProps<'div'> {
  fallback?: any;
}
export interface ToggleIndicatorProps extends HTMLProps<'div'>, ToggleIndicatorBaseProps {}

export component ToggleIndicator(props: MaybeTracked<ToggleIndicatorProps>) {
  const [fallback, children, localProps] = trackSplit(props, ['fallback', 'children']);
  const toggle = useToggleContext();

  let mergedProps = track(() => mergeProps(@toggle.getIndicatorProps(), @localProps));

  <ark.div {...@mergedProps}>
    if (@toggle.pressed) {
      <@children />
    } else {
      <@fallback />
    }
  </ark.div>
}
