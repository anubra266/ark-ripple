import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useMenuContext } from './use-menu-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface MenuArrowBaseProps extends PolymorphicProps<'div'> {}
export interface MenuArrowProps extends HTMLProps<'div'>, MenuArrowBaseProps {}

export component MenuArrow(props: MaybeTracked<MenuArrowProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const menu = useMenuContext();

  let mergedProps = track(() => mergeProps(@menu.getArrowProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
