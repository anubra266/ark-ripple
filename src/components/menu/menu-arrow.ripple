import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useMenuContext } from './use-menu-context';
import { ark } from '../factory';

export interface MenuArrowBaseProps {
	children?: any;
	[key: string]: any;
}
export type MenuArrowProps = MenuArrowBaseProps;

export component MenuArrow(props: MenuArrowProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const menu = useMenuContext();

	let mergedProps = track(() => mergeProps(@menu.getArrowProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
