import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useMenuTriggerItemContext } from './use-menu-trigger-item-context';
import { MenuItemPropsContext } from './use-menu-item-props-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface MenuTriggerItemBaseProps extends PolymorphicProps<'div'> {}
export interface MenuTriggerItemProps extends HTMLProps<'div'>, MenuTriggerItemBaseProps {}

export component MenuTriggerItem(props: MaybeTracked<MenuTriggerItemProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const getTriggerItemProps = useMenuTriggerItemContext();

  let mergedProps = track(() => mergeProps(@getTriggerItemProps?.() ?? {}, @localProps));
  let itemProps = track(() => ({ value: (@mergedProps as any)['data-value'] }));

  MenuItemPropsContext.set(itemProps);

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
