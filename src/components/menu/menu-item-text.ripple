import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useMenuContext } from './use-menu-context';
import { useMenuItemPropsContext } from './use-menu-item-props-context';
import { ark } from '../factory';

export interface MenuItemTextBaseProps {
	children?: any;
	[key: string]: any;
}
export type MenuItemTextProps = MenuItemTextBaseProps;

export component MenuItemText(props: MenuItemTextProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const menu = useMenuContext();
	const itemProps = useMenuItemPropsContext();

	let mergedProps = track(() => mergeProps(@menu.getItemTextProps(@itemProps), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
