import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useMenuContext } from './use-menu-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface MenuIndicatorBaseProps extends PolymorphicProps<'div'> {}
export interface MenuIndicatorProps extends HTMLProps<'div'>, MenuIndicatorBaseProps {}

export component MenuIndicator(props: MaybeTracked<MenuIndicatorProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const menu = useMenuContext();

  let mergedProps = track(() => mergeProps(@menu.getIndicatorProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
