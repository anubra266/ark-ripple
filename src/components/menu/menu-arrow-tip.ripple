import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useMenuContext } from './use-menu-context';
import { ark } from '../factory';

export interface MenuArrowTipBaseProps {
  [key: string]: any;
}
export type MenuArrowTipProps = MenuArrowTipBaseProps;

export component MenuArrowTip(props: MenuArrowTipProps) {
  const menu = useMenuContext();

  let mergedProps = track(() => mergeProps(@menu.getArrowTipProps(), props));

  <ark.div {...@mergedProps} />
}
