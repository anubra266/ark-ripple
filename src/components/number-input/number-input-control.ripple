import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useNumberInputContext } from './use-number-input-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface NumberInputControlBaseProps extends PolymorphicProps<'div'> {}
export interface NumberInputControlProps extends HTMLProps<'div'>, NumberInputControlBaseProps {}

export component NumberInputControl(props: MaybeTracked<NumberInputControlProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const numberInput = useNumberInputContext();

  let mergedProps = track(() => mergeProps(@numberInput.getControlProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
