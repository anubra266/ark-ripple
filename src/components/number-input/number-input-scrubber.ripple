import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useNumberInputContext } from './use-number-input-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface NumberInputScrubberBaseProps extends PolymorphicProps<'div'> {}
export interface NumberInputScrubberProps extends HTMLProps<'div'>, NumberInputScrubberBaseProps {}

export component NumberInputScrubber(props: MaybeTracked<NumberInputScrubberProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const numberInput = useNumberInputContext();

  let mergedProps = track(() => mergeProps(@numberInput.getScrubberProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
