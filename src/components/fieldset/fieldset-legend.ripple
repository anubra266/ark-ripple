import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { useFieldsetContext } from './use-fieldset-context';
import { ark } from '../factory';

export interface FieldsetLegendBaseProps {
	children?: any;
	[key: string]: any;
}
export type FieldsetLegendProps = FieldsetLegendBaseProps;

export component FieldsetLegend(props: FieldsetLegendProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const fieldset = useFieldsetContext();

	let mergedProps = track(() => mergeProps(@fieldset?.getLegendProps(), @localProps));

	<ark.legend {...@mergedProps}>
		<@children />
	</ark.legend>
}
