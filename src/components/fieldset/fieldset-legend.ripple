import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { useFieldsetContext } from './use-fieldset-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FieldsetLegendBaseProps extends PolymorphicProps<'legend'> {}
export interface FieldsetLegendProps extends HTMLProps<'legend'>, FieldsetLegendBaseProps {}

export component FieldsetLegend(props: MaybeTracked<FieldsetLegendProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const fieldset = useFieldsetContext();

  let mergedProps = track(() => mergeProps(@fieldset?.getLegendProps(), @localProps));

  <ark.legend {...@mergedProps}>
    <@children />
  </ark.legend>
}
