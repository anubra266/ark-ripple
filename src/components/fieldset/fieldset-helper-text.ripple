import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { useFieldsetContext } from './use-fieldset-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FieldsetHelperTextBaseProps extends PolymorphicProps<'span'> {}
export interface FieldsetHelperTextProps extends HTMLProps<'span'>, FieldsetHelperTextBaseProps {}

export component FieldsetHelperText(props: MaybeTracked<FieldsetHelperTextProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const fieldset = useFieldsetContext();

  const mergedProps = track(() => mergeProps(@fieldset?.getHelperTextProps(), @localProps));

  <ark.span {...@mergedProps}>
    <@children />
  </ark.span>
}
