import { mergeProps } from 'zag-ripple';
import { track, trackSplit } from 'ripple';
import { FieldsetApiContext } from './use-fieldset-context';
import type { UseFieldsetReturn } from './use-fieldset.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FieldsetRootProviderBaseProps extends PolymorphicProps<'fieldset'> {
value: UseFieldsetReturn;
}
export interface FieldsetRootProviderProps extends HTMLProps<'fieldset'>, FieldsetRootProviderBaseProps {}

export component FieldsetRootProvider(props: MaybeTracked<FieldsetRootProviderProps>) {
  const [fieldset, children, rest] = trackSplit(props, ['value', 'children']);

  FieldsetApiContext.set(fieldset);

  let mergedProps = track(() => mergeProps(@fieldset.getRootProps(), @rest));

  <ark.fieldset {...@mergedProps}>
    <@children />
  </ark.fieldset>
}
