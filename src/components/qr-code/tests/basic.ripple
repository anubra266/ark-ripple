import { QrCode } from 'ark-ripple/qr-code';

export component ComponentUnderTest(props: {
  [key: string]: any;
}) {
  <QrCode.Root value="http://ark-ui.com" encoding={{ ecc: 'H' }} {...props}>
    <QrCode.Frame>
      <QrCode.Pattern />
    </QrCode.Frame>
    <QrCode.Overlay>
      <img src="https://ark-ui.com/icon-192.png" alt="" />
    </QrCode.Overlay>
    <QrCode.DownloadTrigger fileName="qr-code.png" mimeType="image/png">
      {'Download'}
    </QrCode.DownloadTrigger>
  </QrCode.Root>
}
