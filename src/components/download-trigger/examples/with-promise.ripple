import { DownloadTrigger } from 'ark-ripple/download-trigger';
import { Download, Image } from 'lucide-ripple';
import button from 'styles/button.module.css';
import styles from 'styles/download-trigger.module.css';

const fetchImage = async () => {
	const response = await fetch('https://picsum.photos/200/300');
	return response.blob();
};

export component WithPromise() {
	<div class={styles.Root}>
		<div class={styles.Preview}>
			<Image />
			<span class={styles.PreviewText}>{'random-image.jpg (fetched on download)'}</span>
		</div>
		<DownloadTrigger
			class={button.Root}
			data={fetchImage}
			fileName="random-image.jpg"
			mimeType="image/jpeg"
		>
			<Download />
			{' Download Image'}
		</DownloadTrigger>
	</div>
}
