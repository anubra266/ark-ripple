import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useRatingGroupContext } from './use-rating-group-context';
import { ark } from '../factory';

export interface RatingGroupLabelBaseProps {
	children?: any;
	[key: string]: any;
}
export type RatingGroupLabelProps = RatingGroupLabelBaseProps;

export component RatingGroupLabel(props: RatingGroupLabelProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const ratingGroup = useRatingGroupContext();

	let mergedProps = track(() => mergeProps(@ratingGroup.getLabelProps(), @localProps));

	<ark.label {...@mergedProps}>
		<@children />
	</ark.label>
}
