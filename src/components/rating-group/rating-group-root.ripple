import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { RatingGroupApiContext } from './use-rating-group-context';
import { useRatingGroup, type UseRatingGroupProps } from './use-rating-group.ripple';
import { splitRatingGroupProps } from './split-rating-group-props.ripple';
import { ark } from '../factory';

export interface RatingGroupRootBaseProps extends UseRatingGroupProps {
	children?: any;
	[key: string]: any;
}
export type RatingGroupRootProps = RatingGroupRootBaseProps;

export component RatingGroupRoot(props: RatingGroupRootProps) {
	const [children, rest] = trackSplit(props, ['children']);
	const [ratingGroupProps, localProps] = splitRatingGroupProps(@rest);
	const ratingGroup = useRatingGroup(ratingGroupProps);

	RatingGroupApiContext.set(ratingGroup);

	let mergedProps = track(() => mergeProps(@ratingGroup.getRootProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
