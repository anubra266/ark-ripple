import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useRatingGroupContext } from './use-rating-group-context';
import { RatingGroupItemApiContext } from './use-rating-group-item-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface RatingGroupItemBaseProps extends PolymorphicProps<'span'> {
index: number;
}
export interface RatingGroupItemProps extends HTMLProps<'span'>, RatingGroupItemBaseProps {}

export component RatingGroupItem(props: MaybeTracked<RatingGroupItemProps>) {
  const [children, index, localProps] = trackSplit(props, ['children', 'index']);
  const ratingGroup = useRatingGroupContext();

  const itemProps = track(() => ({ index: @index }));
  const itemState = track(() => @ratingGroup.getItemState(@itemProps));

  RatingGroupItemApiContext.set(itemState);

  let mergedProps = track(() => mergeProps(@ratingGroup.getItemProps(@itemProps), @localProps));

  <ark.span {...@mergedProps}>
    <@children />
  </ark.span>
}
