import { autoresizeTextarea } from '@zag-js/auto-resize';
import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFieldContext } from './use-field-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FieldTextareaBaseProps extends PolymorphicProps<'textarea'> {
/**
 * Whether the textarea should autoresize
 * @default false
 */
  autoresize?: boolean | undefined;
}
export interface FieldTextareaProps extends HTMLProps<'textarea'>, FieldTextareaBaseProps {}

export component FieldTextarea(props: MaybeTracked<FieldTextareaProps>) {
  const [autoresize, localProps] = trackSplit(props, ['autoresize']);
  const field = useFieldContext();

  let mergedProps = track(
    () => mergeProps(
      @field?.getTextareaProps(),
      { style: { resize: @autoresize ? 'none' : undefined } },
      @localProps,
    ),
  );

  <ark.textarea
    {...@mergedProps}
    {ref (el: HTMLTextAreaElement) => {
      if (!@autoresize) return;
      return autoresizeTextarea(el);
    }}
  />
}
