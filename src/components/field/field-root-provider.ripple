import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { FieldApiContext } from './use-field-context';
import type { UseFieldReturn } from './use-field.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FieldRootProviderBaseProps extends PolymorphicProps<'div'> {
value: UseFieldReturn;
}
export interface FieldRootProviderProps extends HTMLProps<'div'>, FieldRootProviderBaseProps {}

export component FieldRootProvider(props: MaybeTracked<FieldRootProviderProps>) {
  const [field, children, rest] = trackSplit(props, ['value', 'children']);

  FieldApiContext.set(field);

  let mergedProps = track(() => mergeProps(@field.getRootProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
