import { mergeProps } from 'zag-ripple';
import { trackSplit, track, type Component } from 'ripple';
import { useFieldContext } from './use-field-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FieldRequiredIndicatorBaseProps extends PolymorphicProps<'span'> {
  fallback?: Component;
  children?: Component;
}
export interface FieldRequiredIndicatorProps extends HTMLProps<
  'span'
>, FieldRequiredIndicatorBaseProps {}

export component FieldRequiredIndicator(props: MaybeTracked<FieldRequiredIndicatorProps>) {
  const [fallback, children, localProps] = trackSplit(props, ['fallback', 'children']);
  const field = useFieldContext();

  if (@field?.required) {
    <@fallback />
  }

  let mergedProps = track(() => mergeProps(@field.getRequiredIndicatorProps(), @localProps));
  <ark.span {...@mergedProps}>
    if (@children) {
      <@children />
    } else {
      {'*'}
    }
  </ark.span>
}
