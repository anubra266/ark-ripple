import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFieldContext } from './use-field-context';
import { ark } from '../factory';

export interface FieldSelectBaseProps {
	children?: any;
	[key: string]: any;
}
export type FieldSelectProps = FieldSelectBaseProps;

export component FieldSelect(props: FieldSelectProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const field = useFieldContext();

	let mergedProps = track(() => mergeProps(@field?.getSelectProps(), @localProps));

	<ark.select {...@mergedProps}>
		<@children />
	</ark.select>
}
