import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useFieldContext } from './use-field-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface FieldSelectBaseProps extends PolymorphicProps<'select'> {}
export interface FieldSelectProps extends HTMLProps<'select'>, FieldSelectBaseProps {}

export component FieldSelect(props: MaybeTracked<FieldSelectProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const field = useFieldContext();

  let mergedProps = track(() => mergeProps(@field?.getSelectProps(), @localProps));

  <ark.select {...@mergedProps}>
    <@children />
  </ark.select>
}
