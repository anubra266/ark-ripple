import { Field } from 'ark-ripple/field';
import styles from 'styles/field.module.css';

export component CustomControl() {
	<Field.Root class={styles.Root} invalid>
		<Field.Label class={styles.Label}>{'Any Control'}</Field.Label>
		<Field.Context>
			component children({ context }) {
				<input class={styles.Input} {...@context.getInputProps()} />
			}
		</Field.Context>
		<Field.HelperText class={styles.HelperText}>
			{'Uses getInputProps() for maximum flexibility'}
		</Field.HelperText>
		<Field.ErrorText class={styles.ErrorText}>{'This field has an error'}</Field.ErrorText>
	</Field.Root>
}
