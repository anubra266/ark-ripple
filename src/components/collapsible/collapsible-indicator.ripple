import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useCollapsibleContext } from './use-collapsible-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface CollapsibleIndicatorBaseProps extends PolymorphicProps<'div'> {}
export interface CollapsibleIndicatorProps extends HTMLProps<'div'>, CollapsibleIndicatorBaseProps {}

export component CollapsibleIndicator(props: MaybeTracked<CollapsibleIndicatorProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const collapsible = useCollapsibleContext();

  let mergedProps = track(() => mergeProps(@collapsible.getIndicatorProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
