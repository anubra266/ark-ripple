import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useCollapsibleContext } from './use-collapsible-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface CollapsibleContentBaseProps extends PolymorphicProps<'div'> {}
export interface CollapsibleContentProps extends HTMLProps<'div'>, CollapsibleContentBaseProps {}

export component CollapsibleContent(props: MaybeTracked<CollapsibleContentProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const collapsible = useCollapsibleContext();

  let mergedProps = track(() => mergeProps(@collapsible.getContentProps(), @rest));

  if (!@collapsible.unmounted) {
    <ark.div {...@mergedProps}>
      <@children />
    </ark.div>
  }
}
