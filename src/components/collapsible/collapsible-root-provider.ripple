import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { CollapsibleApiContext } from './use-collapsible-context';
import type { UseCollapsibleReturn } from './use-collapsible.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface CollapsibleRootProviderBaseProps extends PolymorphicProps<'div'> {
value: UseCollapsibleReturn;
}
export interface CollapsibleRootProviderProps extends HTMLProps<'div'>, CollapsibleRootProviderBaseProps {}

export component CollapsibleRootProvider(props: MaybeTracked<CollapsibleRootProviderProps>) {
  const [children, rest] = trackSplit(props, ['children']);
  const collapsible = props.value;

  CollapsibleApiContext.set(collapsible);

  let mergedProps = track(() => mergeProps(@collapsible.getRootProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
