import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSignaturePadContext } from './use-signature-pad-context';
import { ark } from '../factory';

export interface SignaturePadGuideBaseProps {
	[key: string]: any;
}
export type SignaturePadGuideProps = SignaturePadGuideBaseProps;

export component SignaturePadGuide(props: SignaturePadGuideProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const signaturePad = useSignaturePadContext();

	let mergedProps = track(() => mergeProps(@signaturePad.getGuideProps(), @localProps));

	<ark.div {...@mergedProps}>
		<@children />
	</ark.div>
}
