import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSignaturePadContext } from './use-signature-pad-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SignaturePadGuideBaseProps extends PolymorphicProps<'div'> {}
export interface SignaturePadGuideProps extends HTMLProps<'div'>, SignaturePadGuideBaseProps {}

export component SignaturePadGuide(props: MaybeTracked<SignaturePadGuideProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const signaturePad = useSignaturePadContext();

  let mergedProps = track(() => mergeProps(@signaturePad.getGuideProps(), @localProps));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
