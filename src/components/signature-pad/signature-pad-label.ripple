import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSignaturePadContext } from './use-signature-pad-context';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SignaturePadLabelBaseProps extends PolymorphicProps<'label'> {}
export interface SignaturePadLabelProps extends HTMLProps<'label'>, SignaturePadLabelBaseProps {}

export component SignaturePadLabel(props: MaybeTracked<SignaturePadLabelProps>) {
  const [children, localProps] = trackSplit(props, ['children']);
  const signaturePad = useSignaturePadContext();

  let mergedProps = track(() => mergeProps(@signaturePad.getLabelProps(), @localProps));

  <ark.label {...@mergedProps}>
    <@children />
  </ark.label>
}
