import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { SignaturePadApiContext } from './use-signature-pad-context';
import type { UseSignaturePadReturn } from './use-signature-pad.ripple';
import { ark } from '../factory';
import type { HTMLProps, MaybeTracked, PolymorphicProps } from '../../types';

export interface SignaturePadRootProviderBaseProps extends PolymorphicProps<'div'> {
  value: UseSignaturePadReturn;
}
export interface SignaturePadRootProviderProps extends HTMLProps<
  'div'
>, SignaturePadRootProviderBaseProps {}

export component SignaturePadRootProvider(props: MaybeTracked<SignaturePadRootProviderProps>) {
  const [signaturePad, children, rest] = trackSplit(props, ['value', 'children']);

  SignaturePadApiContext.set(signaturePad);

  let mergedProps = track(() => mergeProps(@signaturePad.getRootProps(), @rest));

  <ark.div {...@mergedProps}>
    <@children />
  </ark.div>
}
