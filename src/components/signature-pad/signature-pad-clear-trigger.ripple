import { mergeProps } from 'zag-ripple';
import { trackSplit, track } from 'ripple';
import { useSignaturePadContext } from './use-signature-pad-context';
import { ark } from '../factory';

export interface SignaturePadClearTriggerBaseProps {
	children?: any;
	[key: string]: any;
}
export type SignaturePadClearTriggerProps = SignaturePadClearTriggerBaseProps;

export component SignaturePadClearTrigger(props: SignaturePadClearTriggerProps) {
	const [children, localProps] = trackSplit(props, ['children']);
	const signaturePad = useSignaturePadContext();

	let mergedProps = track(() => mergeProps(@signaturePad.getClearTriggerProps(), @localProps));

	<ark.button {...@mergedProps}>
		<@children />
	</ark.button>
}
