import { isRTL } from '@zag-js/i18n-utils';
import { trackSplit, track, type Component, type Tracked } from 'ripple';
import { LocaleContext, type UseLocaleContext } from './use-locale-context';
import type { MaybeTracked } from '../../types';

export interface LocaleProviderProps {
  children?: Component;
  /**
 * The locale to use for the application.
 * @default 'en-US'
 */
  locale: string;
}

export component LocaleProvider(props: MaybeTracked<LocaleProviderProps>) {
  const [children, locale] = trackSplit(props, ['children', 'locale']);

  const context = track(
    () => ({
      locale: @locale,
      dir: isRTL(@locale ?? 'en-US') ? 'rtl' : 'ltr',
    }),
  );

  LocaleContext.set(context as Tracked<UseLocaleContext>);

  <@children />
}
