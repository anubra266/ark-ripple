import { track } from 'ripple';
import { EnvironmentProvider, useEnvironmentContext } from 'ark-ripple/environment';
import { Portal } from 'ark-ripple/portal';

export component ShadowRoot() {
  let shadowRoot = track<globalThis.ShadowRoot | null>(null);

  <div
    {ref (el: HTMLDivElement) => {
      @shadowRoot = el.attachShadow({ mode: 'open' });
      return () => {
        @shadowRoot = null;
      };
    }}
  />

  if (@shadowRoot) {
    <EnvironmentProvider value={shadowRoot}>
      <PrintEnvironment />
    </EnvironmentProvider>
  }
}

component PrintEnvironment() {
  const environment = useEnvironmentContext();

  <Portal container={@environment.getRootNode()}>
    <pre>{JSON.stringify(String(@environment.getRootNode()), null, 2)}</pre>
  </Portal>
}
