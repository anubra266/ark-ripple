{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["**", "!ark", "!**/tests", "!overrides"]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noArrayIndexKey": "off",
                "noExplicitAny": "off"
            },
            "security": {
                "noDangerouslySetInnerHtml": "off"
            },
            "complexity": {
                "noBannedTypes": "off"
            },
            "performance": {
                "noAccumulatingSpread": "off"
            },
            "a11y": {
                "useButtonType": "off",
                "noLabelWithoutControl": "off",
                "useSemanticElements": "off",
                "useValidAnchor": "off",
                "useKeyWithClickEvents": "off"
            },
            "style": {
                "useConst": "off"
            },
            "correctness": {
                "useUniqueElementIds": "off"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "off"
            }
        }
    },
    "formatter": {
        "enabled": false
    }
}